{
  "application": {
    "name": "uw-app",
    "type": "self_hosted",
    "domain": "uw-app.unfoldingword.workers.dev",
    "destinations": [
      {
        "type": "public",
        "uri": "uw-app.unfoldingword.workers.dev"
      },
      {
        "type": "public",
        "uri": "uw-app-staging.unfoldingword.workers.dev"
      },
      {
        "type": "public",
        "uri": "uw-app-pr-*.unfoldingword.workers.dev"
      }
    ],
    "allowed_idps": ["<one-time-pin-idp-id>"],
    "auto_redirect_to_identity": true,
    "session_duration": "24h",
    "same_site_cookie_attribute": "lax"
  },
  "policies": [
    {
      "name": "Anyone with an email",
      "decision": "allow",
      "include": [
        {
          "everyone": {}
        }
      ]
    }
  ],
  "health_bypass": {
    "application": {
      "name": "uw-app health probe",
      "type": "self_hosted",
      "domain": "uw-app.unfoldingword.workers.dev/health/probe",
      "destinations": [
        {
          "type": "public",
          "uri": "uw-app.unfoldingword.workers.dev/health/probe"
        },
        {
          "type": "public",
          "uri": "uw-app-staging.unfoldingword.workers.dev/health/probe"
        },
        {
          "type": "public",
          "uri": "uw-app-pr-*.unfoldingword.workers.dev/health/probe"
        }
      ],
      "allowed_idps": []
    },
    "policies": [
      {
        "name": "Deploy health probe",
        "decision": "bypass",
        "include": [
          {
            "everyone": {}
          }
        ]
      }
    ]
  },
  "mcp": {
    "application": {
      "name": "uw-app MCP surface",
      "type": "self_hosted",
      "domain": "uw-app.unfoldingword.workers.dev/mcp",
      "destinations": [
        {
          "type": "public",
          "uri": "uw-app.unfoldingword.workers.dev/mcp"
        },
        {
          "type": "public",
          "uri": "uw-app-staging.unfoldingword.workers.dev/mcp"
        },
        {
          "type": "public",
          "uri": "uw-app-pr-*.unfoldingword.workers.dev/mcp"
        }
      ],
      "allowed_idps": ["<one-time-pin-idp-id>"],
      "auto_redirect_to_identity": true,
      "session_duration": "24h"
    },
    "policies": [
      {
        "name": "Anyone with an email",
        "decision": "allow",
        "include": [
          {
            "everyone": {}
          }
        ]
      },
      {
        "name": "Agent service tokens",
        "decision": "non_identity",
        "include": [
          {
            "any_valid_service_token": {}
          }
        ]
      }
    ]
  },
  "migrations": {
    "application": {
      "name": "uw-platform database (migrations)",
      "type": "self_hosted",
      "domain": "uw-db-production.unfoldingword.us",
      "destinations": [
        {
          "type": "public",
          "uri": "uw-db-production.unfoldingword.us"
        }
      ],
      "session_duration": "24h"
    },
    "policies": [
      {
        "name": "GitHub migrations service token",
        "decision": "non_identity",
        "include": [
          {
            "service_token": {
              "token_id": "<github-migrations-service-token-id>"
            }
          }
        ]
      }
    ]
  }
}
