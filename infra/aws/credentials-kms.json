{
  "region": "us-west-2",
  "environments": {
    "staging": {
      "key_arn": "<staging-key-arn>",
      "iam_user": "<staging-iam-user>"
    },
    "production": {
      "key_arn": "<production-key-arn>",
      "iam_user": "<production-iam-user>"
    }
  },
  "key": {
    "key_spec": "SYMMETRIC_DEFAULT",
    "key_usage": "ENCRYPT_DECRYPT"
  },
  "policy": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "WrapAndUnwrapCredentialDataKeys",
        "Effect": "Allow",
        "Action": ["kms:Decrypt", "kms:GenerateDataKey"],
        "Resource": "<key-arn>"
      }
    ]
  }
}
