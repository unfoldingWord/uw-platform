{
  "name": "@uw/uw-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p islands/browser/tsconfig.json && tsc --noEmit -p islands/editor/tsconfig.json && tsc --noEmit -p islands/worker/tsconfig.json",
    "build": "wrangler deploy --dry-run --containers-rollout=none --config ../../infra/uw-platform/wrangler.toml --env staging --outdir \"$PWD/dist\"",
    "dev": "wrangler dev --config ../../infra/uw-platform/wrangler.toml --env staging",
    "deploy:staging": "wrangler deploy --config ../../infra/uw-platform/wrangler.toml --env staging --var COMMIT_SHA:$(git rev-parse HEAD)"
  },
