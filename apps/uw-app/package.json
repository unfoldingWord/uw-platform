{
  "name": "@uw/uw-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p islands/browser/tsconfig.json && tsc --noEmit -p islands/worker/tsconfig.json",
    "build": "wrangler deploy --dry-run --containers-rollout=none --config ../../infra/uw-app/wrangler.toml --env staging --outdir \"$PWD/dist\"",
    "dev": "wrangler dev --config ../../infra/uw-app/wrangler.toml --env staging",
    "deploy:staging": "wrangler deploy --config ../../infra/uw-app/wrangler.toml --env staging --var COMMIT_SHA:$(git rev-parse HEAD)"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@block65/webcrypto-web-push": "2.0.0",
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/containers": "0.3.7",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@octokit/core": "^7.0.8",
    "@uw/contracts": "workspace:*",
    "@uw/core": "workspace:*",
    "@uw/db": "workspace:*",
    "@uw/harness": "workspace:*",
    "@uw/ui": "workspace:*",
    "@uw/uw-ingest": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hast-util-to-string": "^3.0.1",
    "hono": "^4.13.11",
    "idiomorph": "0.8.0",
    "jose": "^6.2.12",
    "openai": "^7.50.0",
    "partysocket": "^1.3.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.1",
    "@types/hast": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/pngjs": "^6.0.5",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "pixelmatch": "7.1.0",
    "playwright": "1.60.0",
    "pngjs": "7.0.0",
    "wrangler": "^4.144.0"
  },
  "contractVersion": "14.6.0"
}
