{
  "name": "@uw/uw-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p islands/browser/tsconfig.json && tsc --noEmit -p islands/worker/tsconfig.json",
    "build": "wrangler deploy --dry-run --config ../../infra/uw-app/wrangler.toml --env staging --outdir \"$PWD/dist\"",
    "dev": "wrangler dev --config ../../infra/uw-app/wrangler.toml --env staging",
    "deploy:staging": "wrangler deploy --config ../../infra/uw-app/wrangler.toml --env staging --var COMMIT_SHA:$(git rev-parse HEAD)"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@block65/webcrypto-web-push": "2.0.0",
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/containers": "0.3.7",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@octokit/core": "^7.0.8",
    "@uw/contracts": "workspace:*",
    "@uw/core": "workspace:*",
    "@uw/db": "workspace:*",
    "@uw/harness": "workspace:*",
    "@uw/ui": "workspace:*",
    "@uw/uw-ingest": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.11",
    "idiomorph": "0.8.0",
    "jose": "^6.2.12",
    "openai": "^7.27.0",
    "partysocket": "^1.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "wrangler": "^4.144.0"
  },
  "contractVersion": "13.3.0"
}
