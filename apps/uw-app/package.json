{
  "name": "@uw/uw-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "build": "wrangler deploy --dry-run --config ../../infra/uw-app/wrangler.toml --env staging --outdir \"$PWD/dist\"",
    "dev": "wrangler dev --config ../../infra/uw-app/wrangler.toml --env staging",
    "deploy:staging": "wrangler deploy --config ../../infra/uw-app/wrangler.toml --env staging --var COMMIT_SHA:$(git rev-parse HEAD)"
  },
  "dependencies": {
    "@uw/contracts": "workspace:*",
    "@uw/core": "workspace:*",
    "hono": "^4.13.11"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.1",
    "wrangler": "^4.144.0"
  },
  "contractVersion": "1.0.0"
}
