{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx"
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "node_modules",
    "**/*.pg.test.ts",
    "testing/postgres.ts",
    "testing/commands.ts",
    "testing/harness-reads.ts",
    "testing/run-host.ts",
    "testing/views.ts",
    "testing/screen-checks.ts",
    "testing/board-world.ts",
    "testing/gate-world.ts",
    "islands/browser/**",
    "islands/worker/**"
  ]
}
