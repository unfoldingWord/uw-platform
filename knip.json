{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/*/check-*.ts", "tools/**/*.test.ts"],
      "project": ["tools/**/*.ts", "*.ts"]
    },
    "apps/*": { "entry": ["**/*.test.ts"], "project": ["**/*.ts"] },
    "packages/*": { "entry": ["**/*.test.ts"], "project": ["**/*.ts"] }
  }
}
