{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["tools/*/check-*.ts", "tools/**/*.test.ts"],
      "project": ["tools/**/*.ts", "*.ts"]
    },
    "apps/*": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "apps/uw-app": {
      "entry": ["index.ts", "**/*.test.ts"],
      "project": ["**/*.ts", "**/*.tsx"],
      "ignoreDependencies": ["cloudflare"]
    },
    "apps/uw-ingest": {
      "entry": ["index.ts", "**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "packages/*": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.ts"]
    },
    "packages/db": {
      "entry": ["**/*.test.ts", "bin/*.ts", "fixtures/*/schema.ts"],
      "project": ["**/*.ts"]
    },
    "packages/ui": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.ts", "**/*.tsx", "**/*.css"]
    },
    "sim": {
      "entry": ["cli/*.ts", "scenarios/*.ts", "**/*.test.ts"],
      "project": ["**/*.ts"]
    }
  }
}
