{
  "name": "uw-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prepare": "husky",
    "check": "tsc --noEmit -p tsconfig.json && pnpm -r run check",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "lint:dates": "node tools/lint/check-dates.ts",
    "lint:vendor": "node tools/lint/check-vendor-sdk.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "architecture": "node tools/architecture/check-architecture.ts",
    "sim": "node sim/cli/sim.ts",
    "sim:all": "node sim/cli/sim.ts all",
    "walk": "node sim/cli/walk.ts",
    "walk:all": "node sim/cli/walk.ts all",
    "trace": "node tools/trace/check-trace.ts",
    "trace:built": "node tools/trace/check-trace.ts --built",
    "db:generate": "pnpm --filter @uw/db exec drizzle-kit generate",
    "db:migrate": "node packages/db/bin/migrate.ts",
    "test": "vitest run",
    "build": "pnpm -r --if-present run build",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "audit:all": "pnpm audit --audit-level high",
    "verify": "pnpm check && pnpm lint && pnpm lint:dates && pnpm lint:vendor && pnpm format:check && pnpm knip && pnpm architecture && pnpm walk:all && pnpm trace:built && pnpm test && pnpm sim:all && pnpm build",
    "ui:css": "node tools/ui/build-css.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "@types/estree": "^1.0.9",
    "@types/node": "^22.20.4",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.1.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "smol-toml": "^1.9.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
