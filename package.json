{
  "name": "uw-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && pnpm -r run check",
    "lint": "eslint .",
    "lint:dates": "node tools/lint/check-dates.ts",
    "test": "vitest run",
    "verify": "pnpm check && pnpm lint && pnpm lint:dates && pnpm test"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  }
}
