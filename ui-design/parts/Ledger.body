    <header class="top">
      <div class="crumb"><span class="jd">28.07</span><span>Monthly Close</span><span class="sep">/</span><b>General ledger</b></div>
      <div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><span>Search everything</span><span class="k">⌘K</span></div>
      <div class="tacts">
        <div class="seg">
          <button onClick="{{prevP}}">‹</button><button class="on">{{period}}</button><button onClick="{{nextP}}">›</button>
        </div>
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M9 13h7M9 17h4"/></svg>Export PDF</button>
        <button class="{{closeCls}}" onClick="{{closeP}}"><svg viewBox="0 0 24 24"><path d="M5 11h14v10H5z"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>{{closeLabel}}</button>
      </div>
    </header>
    <div class="body">
      <div class="phead">
        <div>
          <p class="eyebrow">Fund accounting · double entry · append only</p>
          <h1>General ledger — {{period}}</h1>
          <p class="lede">{{ledgerNote}}</p>
        </div>
        <div class="sp"></div>
        <div style="display:flex;gap:20px">
          <div class="kpi"><span class="l">Trial balance</span><span class="v" style="color:#1F6B39">0.00</span><span class="d">checked 08:02</span></div>
          <div class="kpi"><span class="l">Drafts waiting</span><span class="v">{{nDrafts}}</span><span class="d">oldest 2 days</span></div>
          <div class="kpi"><span class="l">Sage difference</span><span class="v" style="color:#1F6B39">0.00</span><span class="d">parallel run month 4</span></div>
        </div>
      </div>

      <div class="tabs" style="margin-bottom:14px">
        <button class="{{t1}}" onClick="{{go1}}">Journal</button>
        <button class="{{t2}}" onClick="{{go2}}">Funds</button>
        <button class="{{t3}}" onClick="{{go3}}">Budget vs actual</button>
        <button class="{{t4}}" onClick="{{go4}}">Functional expense</button>
      </div>

      <sc-if value="{{isJournal}}" hint-placeholder-val="{{ true }}">
        <div class="row" style="align-items:flex-start">
          <div class="card" style="flex:1;min-width:0">
            <div class="chd">
              <h2>Journal entries</h2>
              <div class="r">
                <div class="chips">
                  <sc-for list="{{filters}}" as="f" hint-placeholder-count="4">
                    <button class="{{f.cls}}" onClick="{{f.pick}}">{{f.label}}</button>
                  </sc-for>
                </div>
              </div>
            </div>
            <div class="cbd flush">
              <table class="tbl">
                <thead><tr>
                  <th style="width:34px"></th><th>Entry</th><th>Date</th><th>Source</th><th>Status</th><th class="num">Debit</th><th class="num">Credit</th><th style="width:92px"></th>
                </tr></thead>
                <tbody>
                  <sc-for list="{{jes}}" as="j" hint-placeholder-count="6">
                    <tr class="hov {{j.selCls}}" onClick="{{j.toggle}}">
                      <td style="color:#5A6E7A;font-weight:800">{{j.caret}}</td>
                      <td>
                        <div style="font-weight:700" class="mono">{{j.id}}</div>
                        <div style="color:#5A6E7A;font-size:11px;font-weight:600">{{j.desc}}</div>
                      </td>
                      <td class="mono">{{j.date}}</td>
                      <td><span class="b {{j.srcTone}}">{{j.src}}</span></td>
                      <td><span class="b {{j.stTone}}">{{j.status}}</span></td>
                      <td class="num">{{j.amt}}</td>
                      <td class="num">{{j.amt}}</td>
                      <td>
                        <sc-if value="{{j.postable}}" hint-placeholder-val="{{ true }}">
                          <button class="btn sm p" onClick="{{j.post}}">Post</button>
                        </sc-if>
                      </td>
                    </tr>
                  </sc-for>
                </tbody>
              </table>
              <sc-if value="{{hasOpen}}" hint-placeholder-val="{{ true }}">
                <div style="background:#F7FBFD;border-top:1px solid var(--line);padding:12px 14px">
                  <div style="display:flex;align-items:center;gap:9px;margin-bottom:8px">
                    <h3>{{openId}} — lines</h3>
                    <span class="b n">{{openDims}}</span>
                    <div class="sp"></div>
                    <span style="color:#5A6E7A;font-size:11px;font-weight:600">every line carries account × fund × function, or it does not post</span>
                  </div>
                  <table class="tbl" style="background:#fff;border:1px solid var(--line);border-radius:8px;overflow:hidden">
                    <thead><tr><th>Account</th><th>Fund</th><th>Function</th><th>Program</th><th class="num">Debit</th><th class="num">Credit</th></tr></thead>
                    <tbody>
                      <sc-for list="{{lines}}" as="l" hint-placeholder-count="4">
                        <tr><td class="mono">{{l.acct}}</td><td>{{l.fund}}</td><td>{{l.func}}</td><td>{{l.prog}}</td><td class="num">{{l.dr}}</td><td class="num">{{l.cr}}</td></tr>
                      </sc-for>
                    </tbody>
                  </table>
                </div>
              </sc-if>
            </div>
            <div class="prov"><span>Append only — a posted entry is reversed, never edited.</span><span>·</span><span class="mono">nightly export → R2 object-locked · 7 yr</span><span>·</span><a>CSV</a></div>
          </div>

          <div class="card" style="width:330px;flex:0 0 330px">
            <div class="chd"><h2>Posting gate</h2><div class="r"><span class="b k">human only</span></div></div>
            <div class="cbd" style="display:flex;flex-direction:column;gap:11px">
              <div class="gate">
                <svg viewBox="0 0 24 24"><path d="M5 11h14v10H5z"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                <div>{{gateText}}</div>
              </div>
              <div>
                <h3 style="margin-bottom:6px">Invariants checked before posting</h3>
                <div style="display:flex;flex-direction:column;gap:5px">
                  <sc-for list="{{checks}}" as="c" hint-placeholder-count="5">
                    <div style="display:flex;align-items:center;gap:7px;font-size:12px;font-weight:600">
                      <span class="b {{c.tone}}">{{c.mark}}</span><span>{{c.text}}</span>
                    </div>
                  </sc-for>
                </div>
              </div>
              <div class="note">Sage remains the system of record until the auditors sign off. Reconciliation runs nightly and this month&rsquo;s difference is zero.</div>
            </div>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{isFunds}}" hint-placeholder-val="{{ false }}">
        <div class="card">
          <div class="chd"><h2>Funds</h2><div class="r"><span class="b n">semi-restricted funds carry an 18% operational assessment · Catalyst Partners 0%</span></div></div>
          <div class="cbd flush">
            <table class="tbl">
              <thead><tr><th>Fund (GAU)</th><th>Restriction</th><th class="num">Opening</th><th class="num">Received</th><th class="num">Released</th><th class="num">Assessment</th><th class="num">Balance</th></tr></thead>
              <tbody>
                <sc-for list="{{funds}}" as="f" hint-placeholder-count="6">
                  <tr class="hov"><td><b>{{f.name}}</b></td><td><span class="b {{f.tone}}">{{f.restr}}</span></td>
                    <td class="num">{{f.open}}</td><td class="num">{{f.recv}}</td><td class="num">{{f.rel}}</td><td class="num">{{f.asmt}}</td><td class="num" style="font-weight:800">{{f.bal}}</td></tr>
                </sc-for>
              </tbody>
            </table>
          </div>
          <div class="prov"><span>Donor restriction is tracked on the fund, never inferred from the program.</span><span>·</span><a>CSV</a><a>PDF</a></div>
        </div>
      </sc-if>

      <sc-if value="{{isBudget}}" hint-placeholder-val="{{ false }}">
        <div class="card">
          <div class="chd"><h2>Budget vs committed vs actual — FY2026 through {{period}}</h2><div class="r"><button class="btn sm q">Open in Charts</button></div></div>
          <div class="cbd">
            <sc-for list="{{bva}}" as="b" hint-placeholder-count="5">
              <div style="display:flex;align-items:center;gap:14px;padding:9px 0;border-bottom:1px solid #F1F5F8">
                <div style="width:230px;flex:0 0 230px;font-weight:700;font-size:12.5px">{{b.name}}</div>
                <div style="flex:1;position:relative;height:22px">
                  <div style="position:absolute;left:0;top:0;height:22px;width:100%;background:#EDF2F5;border-radius:4px"></div>
                  <div style="position:absolute;left:0;top:0;height:22px;width:{{b.commPct}};background:#E3F3FB;border-radius:4px"></div>
                  <div style="position:absolute;left:0;top:0;height:22px;width:{{b.actPct}};background:#31ADE3;border-radius:4px"></div>
                </div>
                <div class="num" style="width:96px;flex:0 0 96px">{{b.actual}}</div>
                <div class="num" style="width:96px;flex:0 0 96px;color:#5A6E7A">{{b.budget}}</div>
                <span class="b {{b.tone}}" style="width:74px;justify-content:flex-end">{{b.var}}</span>
              </div>
            </sc-for>
            <div style="display:flex;gap:16px;margin-top:11px;color:#5A6E7A;font-size:11.5px;font-weight:700">
              <span style="display:flex;align-items:center;gap:6px"><span style="width:10px;height:10px;border-radius:2px;background:#31ADE3"></span>actual</span>
              <span style="display:flex;align-items:center;gap:6px"><span style="width:10px;height:10px;border-radius:2px;background:#E3F3FB"></span>committed</span>
              <span style="display:flex;align-items:center;gap:6px"><span style="width:10px;height:10px;border-radius:2px;background:#EDF2F5"></span>budget</span>
            </div>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{isFunc}}" hint-placeholder-val="{{ false }}">
        <div class="card">
          <div class="chd"><h2>Functional expense — account × function</h2><div class="r"><span class="b n">the 990 statement comes straight off this matrix</span></div></div>
          <div class="cbd flush">
            <table class="tbl">
              <thead><tr><th>Account</th><th class="num">Program</th><th class="num">Management &amp; general</th><th class="num">Fundraising</th><th class="num">Total</th></tr></thead>
              <tbody>
                <sc-for list="{{fx}}" as="f" hint-placeholder-count="7">
                  <tr class="hov"><td><span class="mono">{{f.code}}</span> {{f.name}}</td><td class="num">{{f.prog}}</td><td class="num">{{f.mg}}</td><td class="num">{{f.fr}}</td><td class="num" style="font-weight:800">{{f.tot}}</td></tr>
                </sc-for>
              </tbody>
            </table>
          </div>
          <div class="prov"><span>Every expense line carries a function dimension at posting time — no year-end allocation exercise.</span><span>·</span><a>CSV</a><a>PDF</a></div>
        </div>
      </sc-if>
    </div>
