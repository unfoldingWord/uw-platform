<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { view: 'week', confirmed: {}, recapped: {} }; }
  renderVals() {
    const s = this.state;
    const all = [
      { id: 'm1', date: '2026-08-25', time: '09:00 UTC', name: 'Finance weekly', entity: 'Monthly close · period 2026-08', jd: '20.98', area: 'Finance', people: '3', kind: 'upcoming' },
      { id: 'm2', date: '2026-08-25', time: '15:00 UTC', name: 'Product review — BT Servant', entity: 'BT Servant', jd: '84.98', area: 'Tech & SLR', people: '5', kind: 'upcoming' },
      { id: 'm3', date: '2026-08-26', time: '13:00 UTC', name: 'Grant response review', entity: 'Foundation RFP 2026-08', jd: '43.98', area: 'Engage Benefactors', people: '4', kind: 'upcoming' },
      { id: 'm4', date: '2026-08-28', time: '14:00 UTC', name: 'Field sync', entity: 'Chad Initiative', jd: '63.98', area: 'WBWN Chad', people: '4', kind: 'upcoming' },
      { id: 'm5', date: '2026-08-21', time: '14:00 UTC', name: 'Field sync', entity: 'Chad Initiative', jd: '63.98', area: 'WBWN Chad', people: '4', kind: 'norecap' },
      { id: 'm6', date: '2026-08-20', time: '16:00 UTC', name: 'Finance review', entity: 'FY2027 budget', jd: '20.98', area: 'Finance', people: '3', kind: 'norecap' },
      { id: 'm7', date: '2026-08-19', time: '11:00 UTC', name: 'Board committee — audit', entity: 'Audit binder 2026', jd: '11.98', area: 'Board', people: '6', kind: 'done' },
      { id: 'm8', date: '2026-08-14', time: '08:00 UTC', name: 'Vietnam partner call', entity: 'Vietnam Initiative', jd: '61.98', area: 'WBWN Vietnam', people: '5', kind: 'done' },
    ];
    const view = s.view;
    const rows = all
      .filter((m) => view === 'all' || (view === 'week' ? m.kind === 'upcoming' : m.kind === 'norecap'))
      .map((m) => {
        const done = s.recapped[m.id] || m.kind === 'done';
        const needsRecap = m.kind === 'norecap' && !s.recapped[m.id];
        return {
          ...m,
          recap: m.kind === 'upcoming' ? 'agenda open' : done ? 'filed' : 'draft ready',
          tone: m.kind === 'upcoming' ? 'i' : done ? 'g' : 'k',
          needs: m.kind === 'upcoming' || needsRecap,
          done: !(m.kind === 'upcoming' || needsRecap),
          cta: m.kind === 'upcoming' ? 'Agenda' : 'Review recap',
          act: () => { if (needsRecap) this.setState({ recapped: { ...s.recapped, [m.id]: true } }); },
        };
      });

    const rawActions = [
      { id: 'a1', title: 'Send the revised training calendar to the Chad partner', src: 'Field sync 2026-08-21', due: 'due 2026-08-28' },
      { id: 'a2', title: 'Ask finance whether the 18% assessment applies to the match', src: 'Field sync 2026-08-21', due: 'no date stated' },
      { id: 'a3', title: 'Circulate the audit binder draft to the committee', src: 'Board committee 2026-08-19', due: 'due 2026-08-27' },
      { id: 'a4', title: 'Confirm the FY2027 salary assumptions with HR', src: 'Finance review 2026-08-20', due: 'due 2026-09-02' },
    ];
    const actions = rawActions.map((a) => ({
      ...a,
      open: !s.confirmed[a.id], settled: !!s.confirmed[a.id],
      cls: s.confirmed[a.id] ? 'done' : '',
      confirm: () => this.setState({ confirmed: { ...s.confirmed, [a.id]: true } }),
    }));

    return {
      vWeek: view === 'week' ? 'on' : '', vRecap: view === 'recap' ? 'on' : '', vAll: view === 'all' ? 'on' : '',
      goWeek: () => this.setState({ view: 'week' }), goRecap: () => this.setState({ view: 'recap' }), goAll: () => this.setState({ view: 'all' }),
      listTitle: { week: 'This week', recap: 'Waiting on a recap', all: 'Every meeting you are in' }[view],
      listNote: { week: 'agendas assemble from the linked entity', recap: 'transcript ingested, recap drafted, waiting on a human', all: 'last 90 days' }[view],
      rows,
      kpis: [
        { l: 'This week', v: '4', d: 'across 4 areas' },
        { l: 'Waiting on a recap', v: '2', d: 'oldest 5 days' },
        { l: 'Unconfirmed action items', v: actions.filter((a) => a.open).length, d: 'from 3 meetings' },
        { l: 'Hours in meetings', v: '6.5', d: 'last 7 days' },
      ],
      actions, nOpen: actions.filter((a) => a.open).length,
      byArea: [
        { id: '20.98', name: 'Finance', count: '18', pct: '90%' },
        { id: '63.98', name: 'WBWN Chad', count: '12', pct: '60%' },
        { id: '84.98', name: 'BT Servant', count: '11', pct: '55%' },
        { id: '43.98', name: 'Grants', count: '8', pct: '40%' },
        { id: '11.98', name: 'Board', count: '4', pct: '20%' },
        { id: '61.98', name: 'WBWN Vietnam', count: '4', pct: '20%' },
        { id: '32.98', name: 'Internal tools', count: '3', pct: '15%' },
      ],
    };
  }
}
</script>
