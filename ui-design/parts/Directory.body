    <header class="top">
      <div class="crumb"><span class="jd">15.02</span><span>Staff</span><span class="sep">/</span><b>Directory &amp; access</b></div>
      <div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><span>Search everything</span><span class="k">⌘K</span></div>
      <div class="tacts">
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M9 13h7M9 17h4"/></svg>Access review</button>
        <button class="btn p"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Grant access</button>
      </div>
    </header>
    <div class="body">
      <div class="phead">
        <div>
          <p class="eyebrow">People, responsibilities and who can see what</p>
          <h1>Directory &amp; access</h1>
          <p class="lede">Google is the identity provider; the platform owns authorisation itself. Three roles applied at any scope, every grant audit-logged and versioned — so there is no invisible second console where permissions really live.</p>
        </div>
        <div class="sp"></div>
        <div class="seg">
          <button class="{{vPeople}}" onClick="{{goPeople}}">People</button>
          <button class="{{vAoR}}" onClick="{{goAoR}}">Areas of responsibility</button>
          <button class="{{vGrants}}" onClick="{{goGrants}}">Access grants</button>
        </div>
      </div>

      <sc-if value="{{isPeople}}" hint-placeholder-val="{{ true }}">
        <div class="card">
          <div class="chd"><h2>People</h2><div class="r"><span class="b n">14 staff · 3 contractors</span></div></div>
          <div class="cbd flush">
            <table class="tbl">
              <thead><tr><th>Person</th><th>Role</th><th>Areas of responsibility</th><th>Scope of access</th><th>Offline devices</th></tr></thead>
              <tbody>
                <sc-for list="{{people}}" as="p" hint-placeholder-count="7">
                  <tr class="hov">
                    <td>
                      <div style="display:flex;align-items:center;gap:9px">
                        <span class="av" style="width:24px;height:24px;font-size:10px">{{p.initials}}</span>
                        <div><div style="font-weight:700">{{p.name}}</div><div style="color:#5A6E7A;font-size:11px;font-weight:600">{{p.email}}</div></div>
                      </div>
                    </td>
                    <td>{{p.title}}</td>
                    <td>
                      <div style="display:flex;gap:5px;flex-wrap:wrap">
                        <sc-for list="{{p.aor}}" as="a" hint-placeholder-count="2"><span class="b n">{{a}}</span></sc-for>
                      </div>
                    </td>
                    <td><span class="b {{p.scopeTone}}">{{p.scope}}</span></td>
                    <td>{{p.devices}}</td>
                  </tr>
                </sc-for>
              </tbody>
            </table>
          </div>
          <div class="prov"><span>Auto-provisioned on first sign-in for staff addresses; anyone else lands pending approval.</span></div>
        </div>
      </sc-if>

      <sc-if value="{{isAoR}}" hint-placeholder-val="{{ false }}">
        <div class="card">
          <div class="chd"><h2>Person × area × percentage</h2><div class="r"><span class="sub">the prior an agent uses when a receipt has no other context</span></div></div>
          <div class="cbd flush">
            <table class="tbl">
              <thead><tr><th>Person</th><th>Area</th><th class="num">Allocation</th><th style="width:180px"></th><th>Since</th></tr></thead>
              <tbody>
                <sc-for list="{{aors}}" as="a" hint-placeholder-count="8">
                  <tr class="hov">
                    <td style="font-weight:700">{{a.who}}</td>
                    <td><span class="jd">{{a.jd}}</span> {{a.area}}</td>
                    <td class="num">{{a.pct}}</td>
                    <td><div class="bar"><i style="width:{{a.pct}}"></i></div></td>
                    <td class="mono">{{a.since}}</td>
                  </tr>
                </sc-for>
              </tbody>
            </table>
          </div>
          <div class="prov"><span>Payroll allocation, expense priors and the staff allocation model all read this one table.</span><span>·</span><a>CSV</a></div>
        </div>
      </sc-if>

      <sc-if value="{{isGrants}}" hint-placeholder-val="{{ false }}">
        <div class="row" style="align-items:flex-start">
          <div class="card" style="flex:1.4;min-width:0">
            <div class="chd"><h2>Access grants</h2><div class="r"><span class="b k">3 expiring within 30 days</span></div></div>
            <div class="cbd flush">
              <table class="tbl">
                <thead><tr><th>Person</th><th>Role</th><th>Scope</th><th>Granted by</th><th>Expires</th><th style="width:88px"></th></tr></thead>
                <tbody>
                  <sc-for list="{{grants}}" as="g" hint-placeholder-count="7">
                    <tr class="{{g.cls}}">
                      <td style="font-weight:700">{{g.who}}</td>
                      <td><span class="b {{g.roleTone}}">{{g.role}}</span></td>
                      <td><span class="jd">{{g.scope}}</span> <span style="font-size:11px;color:#5A6E7A;font-weight:700">{{g.scopeName}}</span></td>
                      <td style="color:#5A6E7A">{{g.by}}</td>
                      <td class="mono">{{g.expires}}</td>
                      <td>
                        <sc-if value="{{g.active}}" hint-placeholder-val="{{ true }}">
                          <button class="btn sm" onClick="{{g.revoke}}">Revoke</button>
                        </sc-if>
                        <sc-if value="{{g.revoked}}" hint-placeholder-val="{{ false }}">
                          <span class="b n">revoked</span>
                        </sc-if>
                      </td>
                    </tr>
                  </sc-for>
                </tbody>
              </table>
            </div>
            <div class="prov"><span>Every change is audit-logged and versioned; revoking purges the affected areas from any device on next connect.</span></div>
          </div>

          <div class="card" style="width:340px;flex:0 0 340px">
            <div class="chd"><h2>How roles work</h2></div>
            <div class="cbd" style="display:flex;flex-direction:column;gap:11px">
              <sc-for list="{{roles}}" as="r" hint-placeholder-count="3">
                <div style="border:1px solid var(--line);border-radius:8px;padding:10px">
                  <div style="display:flex;align-items:center;gap:7px;margin-bottom:3px">
                    <span class="b {{r.tone}}">{{r.name}}</span>
                    <span class="mono" style="font-size:10.5px;color:#5A6E7A">{{r.sig}}</span>
                  </div>
                  <div style="color:#3A4A53;font-size:12px">{{r.note}}</div>
                </div>
              </sc-for>
              <div class="note">There is deliberately no separate finance role. Areas already encode the domains, so <span class="mono">admin(20-29)</span> is the finance admin and <span class="mono">editor(40-49)</span> is the fund development team.</div>
            </div>
          </div>
        </div>
      </sc-if>
    </div>
