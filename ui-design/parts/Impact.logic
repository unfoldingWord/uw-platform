<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { sel: 'trainers_certified' }; }
  renderVals() {
    const s = this.state;
    const spark = (vals) => {
      const mx = Math.max.apply(null, vals) || 1;
      return vals.map((v, i) => Math.round(4 + i * (88 / (vals.length - 1))) + ',' + Math.round(22 - (v / mx) * 18)).join(' ');
    };
    const big = (vals, target) => {
      const mx = Math.max(Math.max.apply(null, vals), target) || 1;
      return {
        pts: vals.map((v, i) => Math.round(10 + i * (282 / (vals.length - 1))) + ',' + Math.round(86 - (v / mx) * 72)).join(' '),
        ty: Math.round(86 - (target / mx) * 72),
      };
    };

    const defs = [
      { key: 'trainers_certified', name: 'Facilitators certified', def: 'Distinct people completing all four modules with a checking sign-off', unit: 'people', target: 12, series: [0, 0, 2, 2, 4, 5, 7, 7], status: 'ok', tone: 'g' },
      { key: 'obs_completions', name: 'Open Bible Stories completed', def: 'Language editions community-checked and published to the open licence', unit: 'editions', target: 14, series: [0, 1, 1, 2, 3, 3, 4, 5], status: 'ok', tone: 'g' },
      { key: 'engagement_count', name: 'Active language engagements', def: 'Engagements with at least one event in the last 180 days', unit: 'engagements', target: 420, series: [366, 372, 381, 390, 398, 404, 409, 412], status: 'ok', tone: 'g' },
      { key: 'training_hours', name: 'Training person-hours', def: 'Participants × hours across all training events in the period', unit: 'hours', target: 12000, series: [1100, 2400, 3600, 4900, 6100, 7400, 8300, 9140], status: 'ok', tone: 'g' },
      { key: 'orgs_self_reporting', name: 'Partner orgs self-reporting', def: 'Field organizations writing into the platform without staff re-keying', unit: 'orgs', target: 8, series: [0, 0, 1, 1, 1, 2, 2, 2], status: 'ok', tone: 'g' },
      { key: 'translated_products', name: 'Translation outputs', def: 'Distinct translation outputs recorded against an engagement', unit: 'outputs', target: 2800, series: [2210, 2298, 2361, 2440, 2502, 2571, 2618, 2661], status: 'ok', tone: 'g' },
      { key: 'pb_coverage', name: 'Progress Bible coverage delta', def: 'Cluster languages with no recorded project in the reference dataset', unit: 'languages', target: 0, series: [22, 21, 20, 19, 18, 18, 17, 17], status: 'failed', tone: 'r', lowerBetter: true },
      { key: 'stories_published', name: 'Stories cleared for publication', def: 'Story bank entries with consent recorded and a level above internal', unit: 'stories', target: 20, series: [4, 6, 7, 9, 11, 12, 14, 15], status: 'ok', tone: 'g' },
    ];

    const metrics = defs.map((d) => ({
      ...d,
      latest: d.series[d.series.length - 1].toLocaleString('en-US'),
      target: d.target.toLocaleString('en-US'),
      spark: spark(d.series),
      color: d.status === 'failed' ? '#C4D3DB' : '#31ADE3',
      cls: d.key === s.sel ? 'sel-row' : '',
      pick: () => this.setState({ sel: d.key }),
    }));

    const sel = defs.find((d) => d.key === s.sel) || defs[0];
    const b = big(sel.series, sel.target);

    return {
      metrics,
      selName: sel.name, selDef: sel.def, selTone: sel.tone, selStatus: sel.status,
      selLatest: sel.series[sel.series.length - 1].toLocaleString('en-US'),
      selTarget: sel.target.toLocaleString('en-US'),
      selAsOf: 'as of 2026-08-25', selDir: sel.lowerBetter ? 'direction: down is better' : 'direction: up is better',
      selSeries: b.pts, targetY: b.ty,
      selFailed: sel.status === 'failed',
      selError: 'Last run failed: the Progress Bible refresh has not succeeded since 2026-08-18, so this metric would compare against a stale reference. The snapshot records the failure rather than writing a number.',
      toc: [
        { n: '1', name: 'Inputs', text: 'Funded cohorts, facilitator stipends, checking tools', color: '#C4D3DB', metric: 'budget vs actual', tone: 'n' },
        { n: '2', name: 'Activities', text: 'Modules delivered, checking sessions held', color: '#70C9CC', metric: 'training_hours', tone: 'c' },
        { n: '3', name: 'Outputs', text: 'Drafted and checked scripture in cluster languages', color: '#31ADE3', metric: 'obs_completions', tone: 'i' },
        { n: '4', name: 'Outcomes', text: 'Local facilitators running cohorts unaided', color: '#31ADE3', metric: 'trainers_certified', tone: 'i' },
        { n: '5', name: 'Impact', text: 'Churches using scripture in the language they speak at home', color: '#014263', metric: 'stories + engagements', tone: 'i' },
      ],
    };
  }
}
</script>
