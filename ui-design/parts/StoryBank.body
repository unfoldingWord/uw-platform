    <header class="top">
      <div class="crumb"><span class="jd">44.13</span><span>Stories &amp; Interviews</span><span class="sep">/</span><b>Story Bank</b></div>
      <div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><span>Search everything</span><span class="k">⌘K</span></div>
      <div class="tacts">
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M9 13h7M9 17h4"/></svg>Export PDF</button>
        <button class="btn p"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New story</button>
      </div>
    </header>
    <div class="body" style="display:flex;gap:14px;align-items:flex-start">

      <div class="card" style="width:300px;flex:0 0 300px">
        <div class="chd"><h2>Stories</h2><div class="r"><span class="b n">24</span></div></div>
        <div class="cbd" style="padding:10px 12px">
          <div class="chips">
            <sc-for list="{{filters}}" as="f" hint-placeholder-count="5">
              <button class="{{f.cls}}" onClick="{{f.pick}}">{{f.label}}</button>
            </sc-for>
          </div>
        </div>
        <div class="cbd flush" style="border-top:1px solid var(--line)">
          <sc-for list="{{list}}" as="st" hint-placeholder-count="5">
            <div class="{{st.cls}}" style="padding:10px 12px;border-bottom:1px solid #E7EEF2;cursor:pointer" onClick="{{st.pick}}">
              <div style="display:flex;align-items:center;gap:6px;margin-bottom:3px">
                <span class="b {{st.tone}}">{{st.level}}</span>
                <div class="sp"></div>
                <span class="mono" style="color:#5A6E7A;font-size:10.5px">{{st.date}}</span>
              </div>
              <div style="font-weight:700;font-size:12.5px">{{st.title}}</div>
              <div style="color:#5A6E7A;font-size:11px;font-weight:600">{{st.where}}</div>
            </div>
          </sc-for>
        </div>
      </div>

      <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:14px">
        <div class="card">
          <div class="chd">
            <h2>{{title}}</h2>
            <span class="b {{tone}}">{{level}}</span>
            <div class="r"><span class="sub">collected {{collected}} by {{collector}}</span></div>
          </div>
          <div class="cbd" style="font-size:13.5px;line-height:1.62;color:#3A4A53">
            <p style="margin:0 0 10px">{{body1}}</p>
            <p style="margin:0">{{body2}}</p>
          </div>
          <div class="cbd" style="border-top:1px solid #E7EEF2;display:flex;gap:8px;flex-wrap:wrap">
            <sc-for list="{{tags}}" as="t" hint-placeholder-count="6">
              <span class="b {{t.tone}}">{{t.k}}: {{t.v}}</span>
            </sc-for>
          </div>
          <div class="prov"><span>Tags are relations, not free text — which is why the grant-report assembler can find this story at the moment it is needed.</span></div>
        </div>

        <div class="card">
          <div class="chd">
            <h2>Where this story may appear</h2>
            <div class="r"><span class="sub">the check is a server-side filter, not an editorial habit</span></div>
          </div>
          <div class="cbd flush">
            <sc-for list="{{channels}}" as="c" hint-placeholder-count="4">
              <div style="display:flex;align-items:center;gap:12px;padding:11px 14px;border-bottom:1px solid #E7EEF2">
                <span class="b {{c.tone}}" style="width:130px;justify-content:center">{{c.name}}</span>
                <div style="min-width:0;flex:1">
                  <div style="font-weight:700;font-size:12.5px">{{c.desc}}</div>
                  <div style="color:#5A6E7A;font-size:11px;font-weight:600">{{c.note}}</div>
                </div>
                <button class="{{c.cls}}" onClick="{{c.act}}">{{c.cta}}</button>
              </div>
            </sc-for>
          </div>
          <sc-if value="{{refused}}" hint-placeholder-val="{{ true }}">
            <div class="cbd" style="border-top:1px solid #E7EEF2">
              <div class="gate">
                <svg viewBox="0 0 24 24"><path d="M5 11h14v10H5z"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                <div><b>Refused.</b> {{refusedText}}</div>
              </div>
            </div>
          </sc-if>
        </div>

        <div class="card">
          <div class="chd"><h2>Used in</h2><div class="r"><span class="b n">consent withdrawal can be traced to every one of these</span></div></div>
          <div class="cbd flush">
            <table class="tbl">
              <thead><tr><th>Channel</th><th>Artifact</th><th>Date</th><th>Audience</th></tr></thead>
              <tbody>
                <sc-for list="{{usages}}" as="u" hint-placeholder-count="3">
                  <tr><td><span class="b {{u.tone}}">{{u.ch}}</span></td><td>{{u.artifact}}</td><td class="mono">{{u.date}}</td><td style="color:#5A6E7A">{{u.aud}}</td></tr>
                </sc-for>
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div style="width:314px;flex:0 0 314px;display:flex;flex-direction:column;gap:14px">
        <div class="card">
          <div class="chd"><h2>Sensitivity</h2><div class="r"><span class="b n">an ordered ladder</span></div></div>
          <div class="cbd" style="display:flex;flex-direction:column;gap:7px">
            <sc-for list="{{ladder}}" as="l" hint-placeholder-count="4">
              <button class="{{l.cls}}" style="display:flex;align-items:center;gap:9px;border-radius:8px;padding:9px 11px;text-align:left;width:100%" onClick="{{l.pick}}">
                <span style="width:8px;height:8px;border-radius:50%;background:{{l.color}};flex:0 0 8px"></span>
                <span style="min-width:0">
                  <span style="display:block;font-weight:800;font-size:12.5px">{{l.name}}</span>
                  <span style="display:block;color:#5A6E7A;font-size:11px;font-weight:600">{{l.desc}}</span>
                </span>
              </button>
            </sc-for>
            <div style="color:#5A6E7A;font-size:11px;font-weight:600;margin-top:3px">Each level implies everything below it. Raising a level is a decision a human records; downgrading is always allowed.</div>
          </div>
        </div>

        <div class="card">
          <div class="chd"><h2>Consent &amp; safety</h2><div class="r"><span class="b {{consentTone}}">{{consentState}}</span></div></div>
          <div class="cbd" style="display:flex;flex-direction:column;gap:0">
            <sc-for list="{{consent}}" as="c" hint-placeholder-count="7">
              <div style="display:flex;gap:10px;padding:6px 0;border-bottom:1px solid #F1F5F8">
                <div style="width:118px;flex:0 0 118px;color:#5A6E7A;font-size:11.5px;font-weight:700">{{c.k}}</div>
                <div style="font-weight:600;font-size:12.5px">{{c.v}}</div>
              </div>
            </sc-for>
            <div style="color:#5A6E7A;font-size:11px;font-weight:600;margin-top:9px">Fields, not folklore. A story about work in a sensitive country inherits its engagement&rsquo;s sensitivity as a <b>ceiling</b> — it can never be more public than the field record it describes.</div>
          </div>
        </div>
      </div>
    </div>
