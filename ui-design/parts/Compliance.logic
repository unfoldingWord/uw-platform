<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { generated: {} }; }
  renderVals() {
    const s = this.state;
    const defs = [
      { id: 'a1', name: '990 export pack', note: 'schedules built from the functional expense matrix', cadence: 'annual', last: '2026-05-14', src: 'view:functional-expense@v8', ok: true },
      { id: 'a2', name: 'Statement of functional expenses', note: 'account × function, tied to the GL', cadence: 'monthly', last: '2026-08-01', src: 'view:functional-expense@v8', ok: true },
      { id: 'a3', name: 'Audit binder', note: 'document set with cover, contents and continuous pagination', cadence: 'annual', last: '2026-05-20', src: 'docset:audit-binder@v3', ok: true },
      { id: 'a4', name: 'Access review report', note: 'role grants by person and scope', cadence: 'quarterly', last: '2026-06-01', src: 'view:role-grants@v4', ok: false },
      { id: 'a5', name: 'Segregation of duties report', note: 'who can draft versus who can post', cadence: 'quarterly', last: '2026-06-01', src: 'view:sod@v2', ok: false },
      { id: 'a6', name: 'Donor restriction release schedule', note: 'per fund, with the assessment shown separately', cadence: 'monthly', last: '2026-08-01', src: 'view:fund-activity@v6', ok: true },
      { id: 'a7', name: 'Annual donor statements', note: 'hard credit only, with substantiation language', cadence: 'annual', last: '2026-01-12', src: 'view:giving-history@v9', ok: true },
      { id: 'a8', name: 'Board packet', note: 'assembled from live views, not re-keyed', cadence: 'quarterly', last: '2026-08-06', src: 'docset:board-packet@v11', ok: true },
    ];
    const arts = defs.map((d) => {
      const done = s.generated[d.id];
      const fresh = d.ok || done;
      return {
        ...d,
        last: done ? '2026-08-25' : d.last,
        status: fresh ? 'current' : 'due',
        tone: fresh ? 'g' : 'k',
        stale: !fresh, fresh,
        gen: () => this.setState({ generated: { ...s.generated, [d.id]: true } }),
      };
    });
    return {
      arts,
      nCurrent: arts.filter((a) => a.fresh).length,
      obligations: [
        { when: '7 days', tone: 'k', name: 'Quarterly access review', who: 'admin(00–09) · generated, then signed' },
        { when: '21 days', tone: 'k', name: 'Segregation of duties attestation', who: 'finance admin' },
        { when: '48 days', tone: 'n', name: 'Grant report — Foundation 2025-3311', who: 'fund development' },
        { when: '61 days', tone: 'n', name: 'Annual restore drill', who: 'someone other than the builder' },
        { when: '94 days', tone: 'n', name: 'Insurance renewal evidence pack', who: 'operations' },
        { when: '128 days', tone: 'n', name: 'Audit fieldwork opens', who: 'audit firm · binder generated in advance' },
      ],
      integrity: [
        { mark: 'ok', tone: 'g', text: 'Entries are append only — corrections are reversals' },
        { mark: 'ok', tone: 'g', text: 'Donor restriction tracked on every fund' },
        { mark: 'ok', tone: 'g', text: 'Functional expense dimension on every expense line' },
        { mark: 'ok', tone: 'g', text: 'Nightly tamper-evident export, retained 7 years' },
        { mark: 'ok', tone: 'g', text: 'Sage reconciliation difference: zero, month 4 of the parallel run' },
      ],
    };
  }
}
</script>
