    <header class="top">
      <div class="crumb"><span class="jd">80.13</span><span>Tech &amp; SLR Meta</span><span class="sep">/</span><b>Sprint 2026-34</b></div>
      <div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><span>Search everything</span><span class="k">⌘K</span></div>
      <div class="tacts">
        <span class="b n">GitHub is the source of truth for issue content</span>
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M9 13h7M9 17h4"/></svg>Export PDF</button>
      </div>
    </header>
    <div class="body">
      <div class="phead">
        <div>
          <p class="eyebrow">Read model over GitHub · sprints and epics added here</p>
          <h1>Development</h1>
          <p class="lede">Every issue relates to a product, so a board reads by product as easily as by sprint. Boards, burndowns and rollups are queries over the webhook read model; write-back is limited to link labels and cross-reference comments, so nothing here can corrupt the repository.</p>
        </div>
        <div class="sp"></div>
        <div class="seg">
          <button class="{{vBoard}}" onClick="{{goBoard}}">Board</button>
          <button class="{{vFlow}}" onClick="{{goFlow}}">Flow</button>
          <button class="{{vGate}}" onClick="{{goGate}}">Merge gates</button>
        </div>
      </div>

      <sc-if value="{{isBoard}}" hint-placeholder-val="{{ true }}">
        <div style="display:flex;align-items:center;gap:9px;margin-bottom:12px">
          <span style="font-size:10.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#5A6E7A">Product</span>
          <div class="chips">
            <sc-for list="{{prodFilters}}" as="f" hint-placeholder-count="5"><button class="{{f.cls}}" onClick="{{f.pick}}">{{f.label}}</button></sc-for>
          </div>
          <div class="sp"></div>
          <a data-nav="Products" style="font-size:12px;font-weight:700">Open the product catalogue →</a>
        </div>
        <div class="row" style="align-items:flex-start">
          <sc-for list="{{lanes}}" as="l" hint-placeholder-count="4">
            <div class="lane" style="flex:1">
              <div class="lh"><span>{{l.name}}</span><span style="margin-left:auto"></span><span class="b {{l.tone}}">{{l.count}}</span></div>
              <sc-for list="{{l.cards}}" as="c" hint-placeholder-count="3">
                <div class="kc">
                  <div style="display:flex;align-items:center;gap:6px">
                    <span class="mono" style="color:#5A6E7A;font-size:10.5px">{{c.ref}}</span>
                    <div class="sp"></div>
                    <span class="b {{c.riskTone}}">{{c.risk}}</span>
                  </div>
                  <div style="font-weight:700;font-size:12.5px">{{c.title}}</div>
                  <div style="display:flex;align-items:center;gap:6px;color:#5A6E7A;font-size:10.5px;font-weight:700">
                    <span>{{c.who}}</span><div class="sp"></div><span class="b {{c.prodTone}}">{{c.product}}</span>
                  </div>
                </div>
              </sc-for>
            </div>
          </sc-for>
        </div>
        <div class="card" style="margin-top:14px">
          <div class="cbd" style="display:flex;align-items:center;gap:12px">
            <span class="b k">WIP limit 3 in review</span>
            <span style="font-size:12.5px;color:#3A4A53">Cycle time and cumulative flow come free from status-change history — the same version log that backs every page.</span>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{isFlow}}" hint-placeholder-val="{{ false }}">
        <div class="card">
          <div class="chd"><h2>Sprint burndown — 2026-34</h2><div class="r"><span class="b n">output counts stay on this board, never on a portfolio one</span></div></div>
          <div class="cbd">
            <svg viewBox="0 0 900 260" style="width:100%;height:auto">
              <line x1="52" y1="220" x2="880" y2="220" stroke="#C4D3DB" stroke-width="1.4"></line>
              <line x1="52" y1="16" x2="52" y2="220" stroke="#C4D3DB" stroke-width="1.4"></line>
              <polyline points="52,30 880,220" fill="none" stroke="#C4D3DB" stroke-width="2" stroke-dasharray="5 4"></polyline>
              <polyline points="{{burn}}" fill="none" stroke="#31ADE3" stroke-width="2.6"></polyline>
              <text x="52" y="240" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08-11</text>
              <text x="135" y="240" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08-12</text>
              <text x="218" y="240" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08-13</text>
              <text x="300" y="240" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08-14</text>
              <text x="383" y="240" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08-15</text>
              <text x="466" y="240" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08-16</text>
              <text x="549" y="240" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08-17</text>
              <text x="632" y="240" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08-18</text>
              <text x="714" y="240" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08-19</text>
              <text x="797" y="240" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08-20</text>
              <text x="880" y="240" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08-21</text>
            </svg>
            <div style="display:flex;gap:16px;color:#5A6E7A;font-size:11.5px;font-weight:700">
              <span style="display:flex;align-items:center;gap:6px"><span style="width:14px;height:3px;background:#31ADE3"></span>remaining</span>
              <span style="display:flex;align-items:center;gap:6px"><span style="width:14px;height:3px;background:#C4D3DB"></span>ideal</span>
              <div class="sp"></div><span>points, not issues — an issue closed is a claim to verify</span>
            </div>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{isGate}}" hint-placeholder-val="{{ false }}">
        <div class="row" style="align-items:flex-start">
          <div class="card" style="flex:1;min-width:0">
            <div class="chd"><h2>PR #482 — ledger posting validation</h2><span class="b r">risk tier: ledger</span><div class="r"><span class="sub">a gate you cannot check mechanically is not a gate</span></div></div>
            <div class="cbd flush">
              <table class="tbl">
                <thead><tr><th>Gate</th><th>Requirement</th><th>Result</th></tr></thead>
                <tbody>
                  <sc-for list="{{gates}}" as="g" hint-placeholder-count="6">
                    <tr><td style="font-weight:700">{{g.name}}</td><td style="color:#5A6E7A;font-size:11.5px">{{g.req}}</td><td><span class="b {{g.tone}}">{{g.result}}</span></td></tr>
                  </sc-for>
                </tbody>
              </table>
            </div>
            <div class="cbd" style="border-top:1px solid #E7EEF2">
              <button class="{{mergeCls}}" onClick="{{merge}}">{{mergeLabel}}</button>
              <div style="color:#5A6E7A;font-size:11.5px;font-weight:600;margin-top:8px">{{mergeNote}}</div>
            </div>
          </div>
          <div class="card" style="width:360px;flex:0 0 360px">
            <div class="chd"><h2>Reviewer harness</h2><div class="r"><span class="b n">independent, and arguing</span></div></div>
            <div class="cbd" style="display:flex;flex-direction:column;gap:0">
              <sc-for list="{{reviews}}" as="r" hint-placeholder-count="4">
                <div style="display:flex;gap:10px;padding:9px 0;border-bottom:1px solid #F1F5F8">
                  <span class="b {{r.tone}}" style="height:17px">{{r.lens}}</span>
                  <div><div style="font-weight:700;font-size:12.5px">{{r.finding}}</div><div style="color:#5A6E7A;font-size:11px;font-weight:600">{{r.state}}</div></div>
                </div>
              </sc-for>
              <div class="note" style="margin-top:11px">Findings are fixed or refuted with evidence, never ignored — and the last word is never the reviewers&rsquo;. Only a human merges.</div>
            </div>
          </div>
        </div>
      </sc-if>
    </div>
