<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { view: 'people', revoked: {} }; }
  renderVals() {
    const s = this.state;
    const setV = (k) => () => this.setState({ view: k });

    const rawGrants = [
      { id: 'g1', who: 'Jesse Griffin', role: 'admin', roleTone: 'r', scope: 'org', scopeName: 'super admin', by: 'board resolution', expires: '—' },
      { id: 'g2', who: 'Amara Doumbé', role: 'admin', roleTone: 'r', scope: '60-79', scopeName: 'Field Programs', by: 'Jesse Griffin', expires: '—' },
      { id: 'g3', who: 'Daniel Okoro', role: 'editor', roleTone: 'i', scope: '40-49', scopeName: 'Engage Benefactors', by: 'Jesse Griffin', expires: '—' },
      { id: 'g4', who: 'Grace Mbeki', role: 'editor', roleTone: 'i', scope: '60-79', scopeName: 'Field Programs', by: 'Amara Doumbé', expires: '—' },
      { id: 'g5', who: 'Contract bookkeeper', role: 'editor', roleTone: 'i', scope: '20-29', scopeName: 'Finance', by: 'Jesse Griffin', expires: '2026-09-30' },
      { id: 'g6', who: 'Audit firm reviewer', role: 'viewer', roleTone: 'n', scope: '20-29', scopeName: 'Finance', by: 'Jesse Griffin', expires: '2026-09-15' },
      { id: 'g7', who: 'Design contractor', role: 'viewer', roleTone: 'n', scope: '80-89', scopeName: 'Tech & SLR', by: 'Jesse Griffin', expires: '2026-09-08' },
    ];
    const grants = rawGrants.map((g) => ({
      ...g,
      cls: s.revoked[g.id] ? 'done' : '',
      active: !s.revoked[g.id], revoked: !!s.revoked[g.id],
      revoke: () => this.setState({ revoked: { ...s.revoked, [g.id]: true } }),
    }));

    return {
      vPeople: s.view === 'people' ? 'on' : '', vAoR: s.view === 'aor' ? 'on' : '', vGrants: s.view === 'grants' ? 'on' : '',
      goPeople: setV('people'), goAoR: setV('aor'), goGrants: setV('grants'),
      isPeople: s.view === 'people', isAoR: s.view === 'aor', isGrants: s.view === 'grants',
      people: [
        { initials: 'JG', name: 'Jesse Griffin', email: 'jesse@', title: 'Platform & operations', aor: ['20-29', '30-39', '80-89'], scope: 'org admin', scopeTone: 'r', devices: '1 laptop · pages only' },
        { initials: 'AD', name: 'Amara Doumbé', email: 'amara@', title: 'Field programs lead', aor: ['60-79'], scope: 'admin 60-79', scopeTone: 'i', devices: '1 laptop · sensitive opt-in' },
        { initials: 'DO', name: 'Daniel Okoro', email: 'daniel@', title: 'Fund development', aor: ['40-49'], scope: 'editor 40-49', scopeTone: 'i', devices: 'none' },
        { initials: 'GM', name: 'Grace Mbeki', email: 'grace@', title: 'Training & content', aor: ['60-79', '80-89'], scope: 'editor 60-79', scopeTone: 'i', devices: '1 laptop · pages only' },
        { initials: 'CB', name: 'Contract bookkeeper', email: 'external', title: 'Bookkeeping (contract)', aor: ['20-29'], scope: 'editor 20-29 · expires', scopeTone: 'k', devices: 'none — restricted area' },
        { initials: 'AR', name: 'Audit firm reviewer', email: 'external', title: 'Audit (contract)', aor: ['20-29'], scope: 'viewer 20-29 · expires', scopeTone: 'k', devices: 'none — restricted area' },
        { initials: 'DC', name: 'Design contractor', email: 'external', title: 'Product design (contract)', aor: ['80-89'], scope: 'viewer 80-89 · expires', scopeTone: 'k', devices: 'none' },
      ],
      aors: [
        { who: 'Jesse Griffin', jd: '20-29', area: 'Finance', pct: '40%', since: '2025-01-01' },
        { who: 'Jesse Griffin', jd: '30-39', area: 'Infrastructure', pct: '40%', since: '2025-01-01' },
        { who: 'Jesse Griffin', jd: '80-89', area: 'Tech & SLR', pct: '20%', since: '2025-01-01' },
        { who: 'Amara Doumbé', jd: '60-79', area: 'Field Programs', pct: '100%', since: '2024-06-01' },
        { who: 'Daniel Okoro', jd: '40-49', area: 'Engage Benefactors', pct: '100%', since: '2023-09-01' },
        { who: 'Grace Mbeki', jd: '60-79', area: 'Field Programs', pct: '60%', since: '2025-03-01' },
        { who: 'Grace Mbeki', jd: '80-89', area: 'Tech & SLR', pct: '40%', since: '2025-03-01' },
      ],
      grants,
      roles: [
        { name: 'admin', tone: 'r', sig: 'admin(scope)', note: 'Full control within scope — pages, templates, policies, publish approvals. Org scope is super admin. Only a finance admin posts journal entries or closes a period.' },
        { name: 'editor', tone: 'i', sig: 'editor(scope)', note: 'Create and edit inside the scope, read org-wide. That org-wide read is the open-by-default culture, made explicit rather than assumed.' },
        { name: 'viewer', tone: 'n', sig: 'viewer(scope)', note: 'Read within scope only. Time-boxed grants cover contractors and temporary elevation, and they expire on their own.' },
      ],
    };
  }
}
</script>
