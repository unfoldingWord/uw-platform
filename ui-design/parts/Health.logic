<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { plane: 'data' }; }
  renderVals() {
    const s = this.state;
    const G = '#2E9E5B', A = '#C97F14', R = '#C0392B';
    const planeDefs = [
      { k: 'tech', label: 'Technical' }, { k: 'data', label: 'Data' },
      { k: 'agent', label: 'Agent' }, { k: 'human', label: 'Human & process' },
    ];
    const sets = {
      tech: {
        note: 'requests, queues, workflow steps and crons — one trace id follows a webhook to a posted entry',
        rows: [
          { name: 'Request p95 latency', note: 'all internal routes', value: '184 ms', window: '1 hour', runbook: 'runbook · latency', color: G },
          { name: 'Queue depth', note: 'webhooks, email, search refresh', value: '3', window: 'now', runbook: 'runbook · queues', color: G },
          { name: 'Dead-letter queue', note: 'depth and age of oldest message', value: '0 · —', window: 'now', runbook: 'runbook · dlq', color: G },
          { name: 'Workflow failures', note: 'steps that exhausted retries', value: '1', window: '24 hours', runbook: 'runbook · workflows', color: A },
          { name: 'Page sync sockets', note: 'durable objects serving live pages', value: '6 active', window: 'now', runbook: 'runbook · sync', color: G },
          { name: 'Database query time p95', note: 'through the connection pooler', value: '41 ms', window: '1 hour', runbook: 'runbook · db', color: G },
        ],
      },
      data: {
        note: 'freshness and completeness per source — staleness also shows in the UI where the data is used',
        rows: [
          { name: 'Trial balance equals zero', note: 'domain check, every posting period', value: '0.00', window: 'continuous', runbook: 'runbook · gl-checks', color: G },
          { name: 'Sage mirror lag', note: 'parallel run reconciliation', value: '26 h', window: 'daily', runbook: 'runbook · sage-sync', color: A },
          { name: 'Stripe payouts unreconciled', note: 'payout to gift matching', value: '0', window: '7 days', runbook: 'runbook · stripe', color: G },
          { name: 'Progress Bible refresh', note: 'last successful run 2026-08-18', value: 'failed', window: '7 days', runbook: 'runbook · pb-refresh', color: R },
          { name: 'Draft journal entry aging', note: 'oldest draft awaiting a human', value: '2 days', window: 'continuous', runbook: 'runbook · je-aging', color: G },
          { name: 'Commitments over contract value', note: 'invariant across contracts', value: '0', window: 'continuous', runbook: 'runbook · commitments', color: G },
          { name: 'Unallocated expense items', note: 'items with no dimension resolved', value: '2', window: 'continuous', runbook: 'runbook · expenses', color: A },
          { name: 'Calendar sync', note: 'events mirrored for correlation', value: '07:41 today', window: 'hourly', runbook: 'runbook · calendar', color: G },
        ],
      },
      agent: {
        note: 'every run records model, tokens, cost, duration, tools, rows read, writes made and gates encountered',
        rows: [
          { name: 'Spend this month', note: 'across all personas', value: '$61.40 of $250', window: 'month', runbook: 'runbook · agent-budget', color: G },
          { name: 'Circuit breaker', note: 'per persona and per queue', value: 'armed, not tripped', window: 'continuous', runbook: 'runbook · breaker', color: G },
          { name: 'Runs today', note: 'durable workflow executions', value: '31', window: '24 hours', runbook: 'runbook · agent-runs', color: G },
          { name: 'Gate refusals', note: 'attempts to advance past a human gate', value: '2 · logged', window: '7 days', runbook: 'runbook · gates', color: G },
          { name: 'Writes by agents', note: 'page versions with an agent edit source', value: '46', window: '7 days', runbook: 'runbook · agent-writes', color: G },
          { name: 'Stale learnings', note: 'assumed or inferred past review date', value: '7', window: 'continuous', runbook: 'runbook · memory', color: A },
        ],
      },
      human: {
        note: 'the plane that reveals a module rolled out and then quietly abandoned — invisible to the other three',
        rows: [
          { name: 'Active users per module', note: 'story bank pilot, one team', value: '4 of 6', window: '30 days', runbook: 'runbook · adoption', color: G },
          { name: 'Stale pages', note: 'no edits and no views in 180 days', value: '38', window: 'continuous', runbook: 'runbook · stale', color: A },
          { name: 'Blocked tasks aging', note: 'oldest blocked task', value: '11 days', window: 'continuous', runbook: 'runbook · flow', color: A },
          { name: 'Review queue depth', note: 'items waiting on a human decision', value: '3', window: 'now', runbook: 'runbook · queues', color: G },
          { name: 'WIP limit breaches', note: 'boards over their configured limit', value: '1 · grants drafting', window: '7 days', runbook: 'runbook · wip', color: A },
          { name: 'Unconfirmed action items', note: 'extracted but never decided', value: '4', window: 'continuous', runbook: 'runbook · correlation', color: G },
        ],
      },
    };
    const set = sets[s.plane];

    const modNames = ['core', 'strategy', 'directory', 'agents', 'ledger', 'contracts', 'expenses', 'crm', 'grants', 'field', 'impact', 'stories', 'publish', 'docs_out', 'charts', 'dev', 'comms', 'offline', 'observe', 'infra', 'compliance'];
    const modules = modNames.map((n) => ({
      name: n,
      tone: n === 'field' ? 'r' : n === 'ledger' ? 'k' : 'g',
    }));

    return {
      planes: planeDefs.map((p) => ({ label: p.label, cls: s.plane === p.k ? 'on' : '', pick: () => this.setState({ plane: p.k }) })),
      planeTitle: planeDefs.find((p) => p.k === s.plane).label + ' plane',
      planeNote: set.note, rows: set.rows,
      summary: [
        { l: 'Modules green', v: '19 / 21', d: 'field red · ledger amber', color: '#231F20' },
        { l: 'Donation flow SLO', v: '100%', d: 'webhook → gift → acknowledgment, 30 days', color: G },
        { l: 'Nightly backup', v: 'passed', d: 'restore drill 2026-08-01 · scored 4/4', color: G },
        { l: 'Open alerts', v: '1', d: 'each names its runbook', color: R },
      ],
      modules,
      drills: [
        { state: 'passed', tone: 'g', name: 'Quarterly restore drill', note: 'run by someone other than the builder · 2026-08-01' },
        { state: 'passed', tone: 'g', name: 'Synthetic donation, hourly', note: 'test-mode gift end to end · last 08:00' },
        { state: 'passed', tone: 'g', name: 'Deliberate sync break', note: 'affected screens said so within 4 minutes' },
        { state: 'due', tone: 'k', name: 'Agent cost spike breaker test', note: 'due 2026-09-01' },
      ],
    };
  }
}
</script>
