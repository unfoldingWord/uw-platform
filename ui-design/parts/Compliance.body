    <header class="top">
      <div class="crumb"><span class="jd">23.04</span><span>Audits &amp; 990s</span><span class="sep">/</span><b>Compliance</b></div>
      <div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><span>Search everything</span><span class="k">⌘K</span></div>
      <div class="tacts">
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M9 13h7M9 17h4"/></svg>Audit binder</button>
        <button class="btn p"><svg viewBox="0 0 24 24"><path d="M4 4v6h6M20 20v-6h-6"/><path d="M20 9A8 8 0 0 0 5.6 5.6M4 15a8 8 0 0 0 14.4 3.4"/></svg>Generate now</button>
      </div>
    </header>
    <div class="body">
      <div class="phead">
        <div>
          <p class="eyebrow">Generated on a schedule, not assembled under deadline</p>
          <h1>Obligations &amp; audit artifacts</h1>
          <p class="lede">Every artifact carries a provenance footer resolving back to the exact version and filters that produced it — which is what makes a generated compliance document defensible rather than merely convenient.</p>
        </div>
        <div class="sp"></div>
        <div style="display:flex;gap:20px">
          <div class="kpi"><span class="l">Obligations</span><span class="v">14</span><span class="d">2 due within 30 days</span></div>
          <div class="kpi"><span class="l">Artifacts current</span><span class="v">{{nCurrent}}</span><span class="d">of 8</span></div>
        </div>
      </div>

      <div class="row" style="align-items:flex-start">
        <div class="card" style="flex:1;min-width:0">
          <div class="chd"><h2>Generated artifacts</h2><div class="r"><span class="sub">same query as the screen, same ACL, same footer</span></div></div>
          <div class="cbd flush">
            <table class="tbl">
              <thead><tr><th>Artifact</th><th>Cadence</th><th>Last generated</th><th>Source</th><th>Status</th><th style="width:104px"></th></tr></thead>
              <tbody>
                <sc-for list="{{arts}}" as="a" hint-placeholder-count="8">
                  <tr class="hov">
                    <td><div style="font-weight:700">{{a.name}}</div><div style="color:#5A6E7A;font-size:11px;font-weight:600">{{a.note}}</div></td>
                    <td>{{a.cadence}}</td>
                    <td class="mono">{{a.last}}</td>
                    <td class="mono" style="color:#5A6E7A;font-size:10.5px">{{a.src}}</td>
                    <td><span class="b {{a.tone}}">{{a.status}}</span></td>
                    <td>
                      <sc-if value="{{a.stale}}" hint-placeholder-val="{{ true }}">
                        <button class="btn sm p" onClick="{{a.gen}}">Generate</button>
                      </sc-if>
                      <sc-if value="{{a.fresh}}" hint-placeholder-val="{{ false }}">
                        <button class="btn sm q">Open PDF</button>
                      </sc-if>
                    </td>
                  </tr>
                </sc-for>
              </tbody>
            </table>
          </div>
          <div class="prov">
            <span>Every PDF footer carries</span><span class="mono">slug@version · filters · exported-by · exported-on · sha256</span>
          </div>
        </div>

        <div style="width:344px;flex:0 0 344px;display:flex;flex-direction:column;gap:14px">
          <div class="card">
            <div class="chd"><h2>Obligation calendar</h2><div class="r"><span class="b k">2 within 30 days</span></div></div>
            <div class="cbd" style="display:flex;flex-direction:column;gap:0">
              <sc-for list="{{obligations}}" as="o" hint-placeholder-count="6">
                <div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid #F1F5F8">
                  <span class="b {{o.tone}}" style="height:17px">{{o.when}}</span>
                  <div><div style="font-weight:700;font-size:12.5px">{{o.name}}</div><div style="color:#5A6E7A;font-size:11px;font-weight:600">{{o.who}}</div></div>
                </div>
              </sc-for>
            </div>
          </div>

          <div class="card">
            <div class="chd"><h2>Ledger integrity</h2><div class="r"><span class="b g">all green</span></div></div>
            <div class="cbd" style="display:flex;flex-direction:column;gap:6px">
              <sc-for list="{{integrity}}" as="i" hint-placeholder-count="5">
                <div style="display:flex;align-items:center;gap:8px;font-size:12px;font-weight:600">
                  <span class="b {{i.tone}}">{{i.mark}}</span><span>{{i.text}}</span>
                </div>
              </sc-for>
              <div style="color:#5A6E7A;font-size:11px;font-weight:600;margin-top:5px">Nightly exports land in object-locked storage with a seven-year retention and a checksum manifest.</div>
            </div>
          </div>

          <div class="card">
            <div class="chd"><h2>Access review</h2><div class="r"><span class="b k">due 2026-09-01</span></div></div>
            <div class="cbd" style="display:flex;flex-direction:column;gap:9px">
              <div style="font-size:12.5px;color:#3A4A53">Generated from the grants table: who holds which role at which scope, what expires, and what was granted since the last review.</div>
              <div style="display:flex;gap:14px">
                <div class="kpi"><span class="l">Grants</span><span class="v" style="font-size:17px">31</span></div>
                <div class="kpi"><span class="l">Expiring</span><span class="v" style="font-size:17px">3</span></div>
                <div class="kpi"><span class="l">New</span><span class="v" style="font-size:17px">5</span></div>
              </div>
              <button class="btn sm">Open the review worksheet</button>
            </div>
          </div>
        </div>
      </div>
    </div>
