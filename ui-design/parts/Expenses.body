    <header class="top">
      <div class="crumb"><span class="jd">28.12</span><span>Monthly Close</span><span class="sep">/</span><b>Expense review</b></div>
      <div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><span>Search everything</span><span class="k">⌘K</span></div>
      <div class="tacts">
        <span class="b n">intake · forward a receipt to expenses@</span>
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M9 13h7M9 17h4"/></svg>Export PDF</button>
      </div>
    </header>
    <div class="body" style="display:flex;gap:14px;align-items:flex-start">

      <div class="card" style="width:258px;flex:0 0 258px">
        <div class="chd"><h2>Review queue</h2><div class="r"><span class="b k">{{queueCount}}</span></div></div>
        <div class="cbd flush">
          <sc-for list="{{queue}}" as="q" hint-placeholder-count="5">
            <div class="{{q.cls}}" style="padding:10px 13px;border-bottom:1px solid #E7EEF2;cursor:pointer" onClick="{{q.pick}}">
              <div style="display:flex;align-items:center;gap:7px">
                <span class="b {{q.tone}}">{{q.status}}</span>
                <span style="color:#5A6E7A;font-size:11px;font-weight:700" class="mono">{{q.date}}</span>
                <div class="sp"></div>
                <span class="num" style="font-weight:800">{{q.total}}</span>
              </div>
              <div style="font-weight:700;font-size:12.5px;margin-top:3px">{{q.title}}</div>
              <div style="color:#5A6E7A;font-size:11px;font-weight:600">{{q.who}} · {{q.items}}</div>
            </div>
          </sc-for>
          <div style="padding:11px 13px;color:#5A6E7A;font-size:11px;font-weight:600">Corporate card charges arrive from the other end of the same pipeline; unmatched charges age on their own report.</div>
        </div>
      </div>

      <div style="flex:1;min-width:0;display:flex;flex-direction:column;gap:14px">
        <div class="card">
          <div class="chd">
            <h2>{{repTitle}}</h2>
            <span class="b {{repTone}}">{{repStatus}}</span>
            <div class="r"><span class="sub">received by email 2026-08-24 07:41 · sender resolved to Amara Doumbé</span></div>
          </div>
          <div class="cbd" style="display:flex;gap:16px">
            <div style="width:212px;flex:0 0 212px">
              <div style="border:1px solid var(--line);border-radius:8px;background:#FBFCFD;padding:12px;font-family:ui-monospace,Menlo,monospace;font-size:10.5px;color:#3A4A53;line-height:1.7">
                <div style="font-weight:700;font-size:12px;color:#231F20">HÔTEL LE SAHEL</div>
                <div>N'Djamena, TD</div>
                <div style="border-top:1px dashed #C4D3DB;margin:7px 0"></div>
                <div>2026-08-19 &nbsp; 21:04</div>
                <div>Room 214 · 3 nights</div>
                <div>Lodging &nbsp;&nbsp;&nbsp; 588,000 XAF</div>
                <div>Tax &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 41,160 XAF</div>
                <div style="border-top:1px dashed #C4D3DB;margin:7px 0"></div>
                <div style="font-weight:700">TOTAL &nbsp;&nbsp;&nbsp; 629,160 XAF</div>
                <div>VISA ····4102</div>
              </div>
              <div style="display:flex;gap:6px;margin-top:8px">
                <span class="b n">receipt.heic</span><span class="b n">sha256 9c1e…</span>
              </div>
              <div style="color:#5A6E7A;font-size:11px;font-weight:600;margin-top:7px">Stored in R2 with its hash. Duplicate detection ran on vendor + date + amount + hash.</div>
            </div>

            <div style="flex:1;min-width:0">
              <div style="display:flex;align-items:center;gap:9px;margin-bottom:8px">
                <h3>What the agent read, and how it knows</h3>
                <span class="b n">evidence ledger</span>
              </div>
              <table class="tbl" style="border:1px solid var(--line);border-radius:8px;overflow:hidden">
                <thead><tr><th style="width:96px">Field</th><th style="width:132px">Value</th><th>How it knows</th></tr></thead>
                <tbody>
                  <sc-for list="{{extract}}" as="e" hint-placeholder-count="7">
                    <tr>
                      <td style="color:#5A6E7A;font-weight:700">{{e.k}}</td>
                      <td style="font-weight:700">{{e.v}}</td>
                      <td>
                        <span class="ev {{e.cls}}">{{e.basis}}</span>
                        <span style="color:#5A6E7A;font-size:11.5px"> — {{e.why}}</span>
                      </td>
                    </tr>
                  </sc-for>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="chd">
            <h2>Proposed allocation</h2>
            <span class="b n">{{confirmedNote}}</span>
            <div class="r"><button class="btn sm" onClick="{{confirmAll}}">Confirm all</button></div>
          </div>
          <div class="cbd flush">
            <table class="tbl">
              <thead><tr><th style="width:150px">Item</th><th class="num">Amount</th><th>Account · fund · function · program</th><th style="width:96px">Confidence</th><th style="width:132px"></th></tr></thead>
              <tbody>
                <sc-for list="{{items}}" as="i" hint-placeholder-count="4">
                  <tr class="{{i.rowCls}}">
                    <td>
                      <div style="font-weight:700">{{i.vendor}}</div>
                      <div style="color:#5A6E7A;font-size:11px;font-weight:600" class="mono">{{i.date}}</div>
                    </td>
                    <td class="num">{{i.amt}}<div style="color:#5A6E7A;font-size:10.5px">{{i.fx}}</div></td>
                    <td>
                      <div style="font-weight:600">{{i.dims}}</div>
                      <div style="color:#5A6E7A;font-size:11px;font-weight:600">{{i.reason}} · {{i.prog}}</div>
                    </td>
                    <td>
                      <div style="display:flex;align-items:center;gap:7px">
                        <div class="bar" style="width:52px"><i style="width:{{i.conf}}"></i></div>
                        <span style="font-size:11px;font-weight:700;color:#5A6E7A">{{i.conf}}</span>
                      </div>
                      <sc-if value="{{i.flagged}}" hint-placeholder-val="{{ true }}">
                        <span class="b r" style="margin-top:3px">{{i.flag}}</span>
                      </sc-if>
                    </td>
                    <td>
                      <sc-if value="{{i.pending}}" hint-placeholder-val="{{ true }}">
                        <div style="display:flex;gap:6px">
                          <button class="btn sm p" onClick="{{i.confirm}}">Confirm</button>
                          <button class="btn sm" onClick="{{i.correct}}">Correct</button>
                        </div>
                      </sc-if>
                      <sc-if value="{{i.settled}}" hint-placeholder-val="{{ false }}">
                        <span class="b {{i.settledTone}}">{{i.settledLabel}}</span>
                      </sc-if>
                    </td>
                  </tr>
                </sc-for>
              </tbody>
            </table>
          </div>
          <div class="prov"><span>One click when the guess is right — that is the whole point.</span><span>·</span><span>allocation basis recorded per line</span><span>·</span><span class="mono">expense_items.allocation_basis</span></div>
        </div>
      </div>

      <div style="width:290px;flex:0 0 290px;display:flex;flex-direction:column;gap:14px">
        <div class="card">
          <div class="chd"><h2>Policy check</h2><div class="r"><span class="b {{polTone}}">{{polLabel}}</span></div></div>
          <div class="cbd" style="display:flex;flex-direction:column;gap:10px">
            <div class="gate">
              <svg viewBox="0 0 24 24"><path d="M12 9v5M12 17h.01"/><path d="M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0z"/></svg>
              <div>{{polText}}</div>
            </div>
            <sc-if value="{{canOverride}}" hint-placeholder-val="{{ true }}">
              <button class="btn" onClick="{{override}}">Override with a recorded reason</button>
            </sc-if>
            <div style="color:#5A6E7A;font-size:11.5px;font-weight:600">Caps, thresholds and mileage rates come from the travel policy page with effective dates — never hard-coded, and versioned like any other page.</div>
          </div>
        </div>

        <div class="card">
          <div class="chd"><h2>Approval chain</h2></div>
          <div class="cbd" style="display:flex;flex-direction:column;gap:0">
            <sc-for list="{{chain}}" as="c" hint-placeholder-count="5">
              <div style="display:flex;gap:10px;padding:8px 0;border-bottom:1px solid #F1F5F8">
                <span class="b {{c.tone}}" style="height:17px">{{c.mark}}</span>
                <div>
                  <div style="font-weight:700;font-size:12.5px">{{c.step}}</div>
                  <div style="color:#5A6E7A;font-size:11px;font-weight:600">{{c.who}}</div>
                </div>
              </div>
            </sc-for>
          </div>
        </div>

        <div class="card">
          <div class="cbd" style="display:flex;flex-direction:column;gap:10px">
            <div style="display:flex;align-items:baseline;gap:8px">
              <span class="kpi"><span class="l">Report total</span><span class="v">{{repTotal}}</span></span>
              <div class="sp"></div>
              <span class="b n">{{repItems}}</span>
            </div>
            <button class="{{approveCls}}" onClick="{{approve}}">{{approveLabel}}</button>
            <div class="note">{{approveNote}}</div>
          </div>
        </div>
      </div>
    </div>
