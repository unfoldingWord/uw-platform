<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { rev: 'app', signed: false, invoiced: {} }; }
  renderVals() {
    const s = this.state;
    const raw = [
      { id: 'm1', name: 'Modules 1–2 delivered', due: '2026-05-31', val: '$62,000', ev: '2 training events', evTone: 'i', done: true },
      { id: 'm2', name: 'Modules 3–4 delivered', due: '2026-09-30', val: '$62,000', ev: '1 of 2 events', evTone: 'k', done: false },
      { id: 'm3', name: 'Cohort certification', due: '2026-12-15', val: '$62,000', ev: '7 of 12 certified', evTone: 'k', done: false },
    ];
    const miles = raw.map((m) => {
      const inv = s.invoiced[m.id];
      return {
        ...m,
        status: inv ? 'invoiced' : m.done ? 'accepted' : 'in progress',
        tone: inv ? 'i' : m.done ? 'g' : 'n',
        payable: m.done && !inv,
        pay: () => this.setState({ invoiced: { ...s.invoiced, [m.id]: true } }),
      };
    });
    return {
      miles,
      rClean: s.rev === 'clean' ? 'on' : '', rRed: s.rev === 'red' ? 'on' : '', rApp: s.rev === 'app' ? 'on' : '',
      setClean: () => this.setState({ rev: 'clean' }), setRed: () => this.setState({ rev: 'red' }), setApp: () => this.setState({ rev: 'app' }),
      showRed: s.rev === 'red', showClean: s.rev !== 'red',
      revNote: { clean: 'clean copy — what a counterparty receives', red: 'redline against v8 — every change attributed', app: 'clean body with a revision appendix — the contract default' }[s.rev],
      sigTone: s.signed ? 'g' : 'k', sigState: s.signed ? 'fully executed' : '1 outstanding',
      sigs: [
        { mark: 'signed', tone: 'g', who: 'Partner organization', note: 'counterparty PDF stored with hash · 2026-04-02' },
        { mark: 'signed', tone: 'g', who: 'Program lead — Amara Doumbé', note: 'in platform · 2026-04-01' },
        { mark: s.signed ? 'signed' : 'waiting', tone: s.signed ? 'g' : 'k', who: 'Executive — Jesse Griffin', note: s.signed ? 'in platform · 2026-08-25' : 'required above $100,000' },
      ],
      signCls: 'btn' + (s.signed ? ' off' : ' p'),
      signLabel: s.signed ? 'Executed — commitment now firm' : 'Sign as executive',
      sign: () => this.setState({ signed: true }),
      dims: [
        { k: 'fund', v: 'GAU-CCBT · semi-restricted' },
        { k: 'function', v: 'Program' },
        { k: 'program', v: 'Chad Initiative' },
        { k: 'grant', v: 'Foundation award 2025-3311' },
        { k: 'jd area', v: '25 · Field Contracts & MOUs' },
        { k: 'policy', v: 'Travel & expense policy applies' },
      ],
      others: [
        { kind: 'MOU', tone: 'c', name: 'East Africa Translation Trust', note: 'no money · data sharing · renews 2027-01-01' },
        { kind: 'contract', tone: 'i', name: 'Audit firm engagement 2026', note: '$38,000 · signed 2026-02-14' },
        { kind: 'work order', tone: 'i', name: 'WO-2026-052 — OBS drafting', note: '$142,000 · 2 milestones open' },
        { kind: 'expiring', tone: 'k', name: 'Nigeria Bible Partners MOU', note: 'expires 2026-10-31 · renewal task created' },
      ],
    };
  }
}
</script>
