<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { actor: 'human', moved: {}, refusal: '' }; }
  renderVals() {
    const s = this.state;
    const isAgent = s.actor === 'agent';

    const stageDefs = [
      { key: 'intake', name: 'Intake', pickup: 'auto', gate: 'checks', wip: '2 of 5', instr: 'RFP triage brief' },
      { key: 'drafting', name: 'Drafting', pickup: 'allowed', gate: 'checks', wip: '3 of 3', instr: 'Funder template + house voice' },
      { key: 'review', name: 'Human review', pickup: 'none', gate: 'human_approval', wip: '2 of 4', instr: 'Review checklist' },
      { key: 'submit', name: 'Submitted', pickup: 'none', gate: 'none', wip: '1', instr: 'Submission log' },
    ];
    const tone = { auto: 'k', allowed: 'c', none: 'n' };
    const gTone = { checks: 'i', human_approval: 'k', none: 'n' };

    const cardDefs = [
      { id: 'c1', stage: 'intake', title: 'Technology foundation RFP', meta: '11 questions · 6,000 word cap', claim: 'agent:grant-writer', claimTone: 'k', lease: 'lease 12m', pct: '25%', progress: 'scoping the ask' },
      { id: 'c2', stage: 'drafting', title: 'Foundation RFP 2026-08', meta: '9 of 11 answered · cites 4 impact metrics', claim: 'agent:grant-writer', claimTone: 'k', lease: 'lease 41m', pct: '82%', progress: 'drafting Q10' },
      { id: 'c3', stage: 'drafting', title: 'Corporate giving program', meta: 'budget narrative pending finance', claim: 'agent:grant-writer', claimTone: 'k', lease: 'lease 8m', pct: '55%', progress: 'waiting on a figure' },
      { id: 'c4', stage: 'review', title: 'Bilateral agency concept note', meta: 'drafted 2026-08-22 · 2 comments', claim: 'Jesse Griffin', claimTone: 'i', lease: 'no lease', pct: '100%', progress: 'awaiting your decision' },
      { id: 'c5', stage: 'submit', title: 'National foundation — gateway languages', meta: 'submitted 2026-08-04 · decision 2026-10-01', claim: 'Daniel Okoro', claimTone: 'i', lease: '—', pct: '100%', progress: 'closed' },
    ];

    const order = ['intake', 'drafting', 'review', 'submit'];
    const stages = stageDefs.map((st) => ({
      name: st.name, pickup: st.pickup, gate: st.gate,
      pickTone: tone[st.pickup], gateTone: gTone[st.gate],
      wip: st.wip, wipTone: st.wip === '3 of 3' ? 'r' : 'n',
      cards: cardDefs
        .filter((c) => (s.moved[c.id] || c.stage) === st.key)
        .map((c) => {
          const cur = s.moved[c.id] || c.stage;
          const stage = stageDefs.find((x) => x.key === cur);
          const blocked = isAgent && stage.gate === 'human_approval';
          const last = cur === 'submit';
          return {
            ...c,
            advCls: 'btn sm' + (last ? ' off' : blocked ? ' off' : isAgent ? '' : ' p'),
            advLabel: last ? 'closed' : blocked ? 'gate: human_approval' : 'Advance',
            advance: () => {
              if (last) return;
              if (blocked) {
                this.setState({ refusal: 'The advance verb does not exist in an agent toolset for a stage whose exit gate is human_approval. The card stays in Human review, and the attempt is logged with actor, kind and evidence.' });
                return;
              }
              const next = order[order.indexOf(cur) + 1];
              this.setState({ moved: { ...s.moved, [c.id]: next }, refusal: '' });
            },
          };
        }),
    }));

    return {
      asHuman: isAgent ? '' : 'on', asAgent: isAgent ? 'on' : '',
      beHuman: () => this.setState({ actor: 'human', refusal: '' }),
      beAgent: () => this.setState({ actor: 'agent', refusal: '' }),
      actorNote: isAgent
        ? 'You are looking at the board as a subscribed agent would. It can claim, work and move cards through stages with mechanical gates — and nowhere else.'
        : 'Agents subscribe to this queue and claim cards on a lease so two never grab the same one. Switch the actor above to see which moves an agent simply cannot make.',
      stages,
      refused: !!s.refusal, refusedText: s.refusal,
      cfg: stageDefs.map((st) => ({ ...st, pickTone: tone[st.pickup], gateTone: gTone[st.gate] })),
      steps: [
        { mark: 'ok', tone: 'g', step: 'Read the card and resolve context', detail: 'policies + decisions + learnings for this entity', cost: '$0.04' },
        { mark: 'ok', tone: 'g', step: 'Scout pass — verify the premise', detail: 'checked the RFP against current program data before drafting', cost: '$0.11' },
        { mark: 'ok', tone: 'g', step: 'Draft 9 of 11 responses', detail: 'wrote page versions attached to the card, edit_source agent:grant-writer', cost: '$0.71' },
        { mark: 'retry', tone: 'k', step: 'Render the budget table', detail: 'failed once on a stale figure; retried from that step, not from scratch', cost: '$0.06' },
        { mark: 'ok', tone: 'g', step: 'Run stage checks', detail: 'required sections present, word caps respected, dates ISO', cost: '$0.01' },
        { mark: 'wait', tone: 'n', step: 'Park at the approval gate', detail: 'run hibernates instead of holding compute', cost: '$0.00' },
      ],
    };
  }
}
</script>
