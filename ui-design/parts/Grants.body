    <header class="top">
      <div class="crumb"><span class="jd">43.16</span><span>Grants</span><span class="sep">/</span><b>Grants</b></div>
      <div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><span>Search everything</span><span class="k">⌘K</span></div>
      <div class="tacts">
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M9 13h7M9 17h4"/></svg>Export PDF</button>
        <button class="btn p"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New opportunity</button>
      </div>
    </header>
    <div class="body">
      <div class="phead">
        <div>
          <p class="eyebrow">Pipeline · confidence tiered</p>
          <h1>Grants</h1>
          <p class="lede">Pipeline and trend are two lenses on the same money and are never summed. Reporting draws promised-versus-delivered straight from the impact model and the story bank.</p>
        </div>
        <div class="sp"></div>
        <div class="seg">
          <button class="{{vPipe}}" onClick="{{setPipe}}">Pipeline</button>
          <button class="{{vRep}}" onClick="{{setRep}}">Report assembly</button>
        </div>
      </div>

      <sc-if value="{{isPipe}}" hint-placeholder-val="{{ true }}">
        <div class="row" style="margin-bottom:14px">
          <sc-for list="{{kpis}}" as="k" hint-placeholder-count="4">
            <div class="card" style="flex:1"><div class="cbd">
              <div class="kpi"><span class="l">{{k.l}}</span><span class="v">{{k.v}}</span><span class="d">{{k.d}}</span></div>
            </div></div>
          </sc-for>
        </div>
        <div class="row" style="align-items:flex-start">
          <sc-for list="{{lanes}}" as="l" hint-placeholder-count="5">
            <div class="lane" style="flex:1">
              <div class="lh"><span style="width:7px;height:7px;border-radius:50%;background:{{l.color}}"></span>{{l.name}}<span style="margin-left:auto;font-weight:800">{{l.sum}}</span></div>
              <sc-for list="{{l.cards}}" as="c" hint-placeholder-count="3">
                <div class="kc">
                  <div style="font-weight:800;font-size:12.5px">{{c.funder}}</div>
                  <div style="color:#5A6E7A;font-size:11px;font-weight:600">{{c.purpose}}</div>
                  <div style="display:flex;align-items:center;gap:6px">
                    <span class="num" style="font-weight:800">{{c.amt}}</span>
                    <div class="sp"></div>
                    <span class="b {{c.tone}}">{{c.tag}}</span>
                  </div>
                  <div style="color:#5A6E7A;font-size:10.5px;font-weight:700" class="mono">{{c.due}}</div>
                </div>
              </sc-for>
            </div>
          </sc-for>
        </div>
        <div class="card" style="margin-top:14px">
          <div class="cbd" style="display:flex;align-items:center;gap:12px">
            <span class="b k">WIP limit 3</span>
            <span style="font-size:12.5px;color:#3A4A53">Drafting holds three at a time. The fourth waits in Qualified until one clears — visible demand before commitment, which is the same rule the project boards run.</span>
          </div>
        </div>
      </sc-if>

      <sc-if value="{{isRep}}" hint-placeholder-val="{{ false }}">
        <div class="row" style="align-items:flex-start">
          <div class="card" style="flex:1;min-width:0">
            <div class="chd">
              <h2>Foundation award 2025-3311 — Q3 report</h2>
              <span class="b k">due 2026-10-15</span>
              <div class="r"><button class="btn sm">Preview PDF</button><button class="btn sm p">Send to review queue</button></div>
            </div>
            <div class="cbd flush">
              <table class="tbl">
                <thead><tr><th>Promised in the proposal</th><th class="num">Target</th><th class="num">Delivered</th><th>Evidence</th><th>Status</th></tr></thead>
                <tbody>
                  <sc-for list="{{promises}}" as="p" hint-placeholder-count="5">
                    <tr class="hov">
                      <td style="font-weight:600">{{p.text}}</td>
                      <td class="num">{{p.target}}</td>
                      <td class="num" style="font-weight:800">{{p.actual}}</td>
                      <td><span class="b {{p.evTone}}">{{p.ev}}</span></td>
                      <td><span class="b {{p.tone}}">{{p.status}}</span></td>
                    </tr>
                  </sc-for>
                </tbody>
              </table>
            </div>
            <div class="prov"><span>Numbers read live from the impact model</span><span>·</span><span class="mono">impact_snapshots as-of 2026-08-25</span><span>·</span><span>narrative from the story bank, consent checked</span></div>
          </div>

          <div class="card" style="width:340px;flex:0 0 340px">
            <div class="chd"><h2>Narrative candidates</h2><div class="r"><span class="b n">story bank</span></div></div>
            <div class="cbd" style="display:flex;flex-direction:column;gap:9px">
              <sc-for list="{{stories}}" as="st" hint-placeholder-count="4">
                <div style="border:1px solid var(--line);border-radius:8px;padding:10px">
                  <div style="display:flex;align-items:center;gap:7px;margin-bottom:4px">
                    <span class="b {{st.tone}}">{{st.level}}</span>
                    <span style="color:#5A6E7A;font-size:10.5px;font-weight:700" class="mono">{{st.date}}</span>
                  </div>
                  <div style="font-weight:700;font-size:12.5px">{{st.title}}</div>
                  <div style="color:#5A6E7A;font-size:11px;font-weight:600;margin-bottom:6px">{{st.note}}</div>
                  <button class="{{st.cls}}" onClick="{{st.add}}">{{st.cta}}</button>
                </div>
              </sc-for>
              <div class="note">A story used here is written to its usage log, so the same funder never receives the same story twice — and a consent withdrawal can be traced to every place the story landed.</div>
            </div>
          </div>
        </div>
      </sc-if>
    </div>
