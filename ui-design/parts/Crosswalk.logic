<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { metric: 'pages', cell: '62|ccbt' }; }
  renderVals() {
    const s = this.state;
    const cols = ['Church-Centric BT', 'Content Development', 'Tools & Technology', 'Field Training', 'Catalyst Partners'];
    const keys = ['ccbt', 'content', 'tools', 'training', 'catalyst'];

    const areas = [
      { id: '00', range: '00-09', name: 'unfoldingWord Home', rel: ['reports_on', 'reports_on', 'reports_on', 'reports_on', 'reports_on'], pages: [44, 26, 21, 14, 11], projects: [0, 0, 0, 0, 0], spend: [0, 0, 0, 0, 0], stories: [0, 0, 0, 0, 0] },
      { id: '10', range: '10-19', name: 'Internal Operations & Administration', rel: ['supports', 'supports', 'supports', 'supports', 'supports'], pages: [31, 17, 19, 13, 8], projects: [1, 1, 1, 0, 0], spend: [82000, 44000, 51000, 26000, 12000], stories: [0, 0, 0, 0, 0] },
      { id: '20', range: '20-29', name: 'Finance', rel: ['supports', 'supports', 'supports', 'supports', 'supports'], pages: [63, 38, 34, 22, 17], projects: [2, 1, 1, 1, 1], spend: [1188400, 618900, 590200, 274500, 96300], stories: [0, 0, 0, 0, 0] },
      { id: '30', range: '30-39', name: 'Infrastructure', rel: ['supports', 'supports', 'supports', 'supports', 'supports'], pages: [58, 22, 96, 11, 6], projects: [1, 1, 6, 0, 0], spend: [24000, 14000, 61000, 6000, 3000], stories: [0, 0, 0, 0, 0] },
      { id: '40', range: '40-49', name: 'Engage Benefactors', rel: ['funds', 'funds', 'funds', 'funds', 'funds'], pages: [37, 21, 19, 14, 44], projects: [2, 1, 1, 1, 3], spend: [0, 0, 0, 0, 0], stories: [11, 6, 4, 5, 2] },
      { id: '50', range: '50-59', name: 'Innovation & Strategy', rel: ['supports', 'supports', 'supports', 'supports', 'supports'], pages: [46, 28, 31, 17, 14], projects: [2, 2, 2, 1, 1], spend: [38000, 26000, 31000, 12000, 9000], stories: [2, 1, 1, 1, 0] },
      { id: '62', range: '60-79', name: 'Field Programs', rel: ['owns', 'owns', 'reports_on', 'owns', 'reports_on'], pages: [334, 200, 38, 176, 9], projects: [30, 16, 3, 16, 0], spend: [1154000, 561000, 59000, 392500, 0], stories: [33, 17, 3, 20, 0] },
      { id: '80', range: '80-89', name: 'Tech & SLR', rel: ['reports_on', 'supports', 'owns', 'reports_on', 'reports_on'], pages: [19, 46, 214, 8, 3], projects: [1, 4, 17, 0, 0], spend: [46000, 121000, 512300, 0, 0], stories: [2, 4, 9, 0, 0] },
      { id: '90', range: '90-99', name: 'Catalyzation', rel: ['supports', 'supports', 'supports', 'supports', 'owns'], pages: [52, 19, 14, 61, 88], projects: [4, 1, 1, 5, 6], spend: [96000, 18000, 11000, 74000, 84000], stories: [7, 2, 1, 9, 6] },
    ];

    const metricDefs = [
      { key: 'pages', label: 'Pages' }, { key: 'projects', label: 'Active projects' },
      { key: 'spend', label: 'Actual spend' }, { key: 'stories', label: 'Stories' },
    ];
    const relTone = { owns: 'i', supports: 'c', funds: 'k', reports_on: 'n' };
    const relBg = { owns: '#E3F3FB', supports: '#F2FAFA', funds: '#FDF7EC', reports_on: 'transparent' };
    const fmt = (v) => s.metric === 'spend' ? (v ? '$' + Math.round(v / 1000) + 'K' : '—') : (v || '—');

    const rows = areas.map((a) => {
      const vals = a[s.metric];
      const total = vals.reduce((x, y) => x + y, 0);
      return {
        range: a.range, name: a.name,
        total: fmt(total),
        cells: vals.map((v, i) => ({
          v: fmt(v),
          bg: relBg[a.rel[i]],
          fg: a.rel[i] === 'reports_on' ? '#5A6E7A' : '#231F20',
          weight: a.rel[i] === 'owns' ? 800 : 600,
          cls: (a.id + '|' + keys[i]) === s.cell ? 'sel-row' : '',
          pick: () => this.setState({ cell: a.id + '|' + keys[i] }),
        })),
      };
    });

    const [aid, pid] = s.cell.split('|');
    const area = areas.find((a) => a.id === aid) || areas[0];
    const ci = Math.max(0, keys.indexOf(pid));
    const rel = area.rel[ci];
    const relText = {
      owns: 'This area owns that part of the cascade — its pages, projects and budget lines are filed here and permission to edit them is granted at this area.',
      supports: 'This area supports the intent without owning it. Finance supports every portfolio; that is why there is no separate finance role.',
      funds: 'This area funds the intent. Gifts, grants and soft credits land here and roll along the strategic axis to the fund.',
      reports_on: 'This area reports on the intent but neither owns nor funds it — the relation exists so the rollup is explicit rather than implied.',
    }[rel];

    return {
      cols, rows,
      metrics: metricDefs.map((m) => ({ label: m.label, cls: s.metric === m.key ? 'on' : '', pick: () => this.setState({ metric: m.key }) })),
      metricNote: { pages: 'count of pages filed in the area serving that intent', projects: 'projects with status active', spend: 'posted actuals FY2026 to date', stories: 'story bank entries linked to both coordinates' }[s.metric],
      cellTitle: area.range + ' ' + area.name + ' × ' + cols[ci],
      cellRel: rel.replace('_', ' '),
      cellTone: relTone[rel],
      cellText: relText,
      cellKpis: [
        { l: 'Pages', v: area.pages[ci] || '—' },
        { l: 'Projects', v: area.projects[ci] || '—' },
        { l: 'Spend', v: area.spend[ci] ? '$' + Math.round(area.spend[ci] / 1000) + 'K' : '—' },
        { l: 'Stories', v: area.stories[ci] || '—' },
      ],
      cellLinks: [
        { dir: 'area →', name: 'Everything in ' + area.name },
        { dir: 'intent →', name: 'Everything serving ' + cols[ci] },
        { dir: 'both →', name: 'The intersection as a saved view' },
        { dir: 'map', name: 'Edit this relation in jd_cascade_map' },
      ],
    };
  }
}
</script>
