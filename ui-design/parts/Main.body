    <header class="top">
      <div class="crumb"><b>Today</b><span class="sep">·</span><span>2026-08-25</span></div>
      <div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><span>Search everything</span><span class="k">⌘K</span></div>
      <div class="tacts">
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New</button>
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M9 13h7M9 17h4"/></svg>Export PDF</button>
      </div>
    </header>
    <div class="body">
      <div class="phead">
        <div>
          <p class="eyebrow">Tuesday · 2026-08-25</p>
          <h1>Good morning, Jesse</h1>
          <p class="lede">Three things are waiting on a human decision. Everything an agent drafted overnight is parked at a gate until you confirm it.</p>
        </div>
        <div class="sp"></div>
        <div class="seg">
          <button class="{{segMine}}" onClick="{{setMine}}">My scope</button>
          <button class="{{segOrg}}" onClick="{{setOrg}}">Org-wide</button>
        </div>
      </div>

      <div class="row" style="align-items:stretch">
        <div class="card" style="flex:1.15">
          <div class="chd">
            <h2>Waiting on me</h2>
            <span class="b k dot">{{gateCount}} gates</span>
            <div class="r"><span class="sub">server-enforced · an agent cannot advance these</span></div>
          </div>
          <div class="cbd" style="display:flex;flex-direction:column;gap:9px">
            <sc-for list="{{gates}}" as="g" hint-placeholder-count="4">
              <div style="display:flex;align-items:center;gap:11px;border:1px solid #E7EEF2;border-radius:8px;padding:9px 11px;background:#FCFDFE">
                <span class="b {{g.tone}}">{{g.mod}}</span>
                <div style="min-width:0">
                  <div style="font-weight:700">{{g.title}}</div>
                  <div style="color:#5A6E7A;font-size:11.5px;font-weight:600">{{g.meta}}</div>
                </div>
                <div class="sp"></div>
                <button class="btn sm p" onClick="{{g.act}}">{{g.cta}}</button>
                <button class="btn sm q" onClick="{{g.act}}">Open</button>
              </div>
            </sc-for>
            <sc-if value="{{noGates}}" hint-placeholder-val="{{ false }}">
              <div class="empty">Nothing waiting. Cleared at {{clearedAt}}.</div>
            </sc-if>
          </div>
        </div>

        <div class="card" style="flex:1">
          <div class="chd">
            <h2>My tasks</h2>
            <div class="r">
              <button class="{{tabMine}}" onClick="{{tMine}}">Mine ({{nMine}})</button>
              <button class="{{tabSug}}" onClick="{{tSug}}">Suggested ({{nSug}})</button>
            </div>
          </div>
          <div class="cbd flush">
            <sc-for list="{{tasks}}" as="t" hint-placeholder-count="5">
              <div style="display:flex;align-items:flex-start;gap:10px;padding:9px 14px;border-bottom:1px solid #E7EEF2">
                <button onClick="{{t.toggle}}" style="margin-top:2px">
                  <span class="{{t.boxCls}}" style="display:block;width:15px;height:15px;border-radius:4px;border:1.6px solid #C4D3DB"></span>
                </button>
                <div style="min-width:0;flex:1">
                  <div class="{{t.textCls}}" style="font-weight:600">{{t.title}}</div>
                  <div style="display:flex;align-items:center;gap:7px;margin-top:2px;color:#5A6E7A;font-size:11px;font-weight:600">
                    <span>{{t.parent}}</span><span style="opacity:.5">·</span><span>due {{t.due}}</span>
                    <span class="b {{t.srcTone}}">{{t.src}}</span>
                  </div>
                </div>
                <sc-if value="{{t.isSuggested}}" hint-placeholder-val="{{ true }}">
                  <button class="btn sm" onClick="{{t.confirm}}">Confirm</button>
                </sc-if>
              </div>
            </sc-for>
            <div style="padding:9px 14px;color:#5A6E7A;font-size:11.5px;font-weight:600">{{taskFoot}}</div>
          </div>
        </div>
      </div>

      <div class="row" style="margin-top:14px;align-items:stretch">
        <div class="card" style="flex:1.6">
          <div class="chd">
            <h2>Portfolios — money, work and impact on one line</h2>
            <div class="r"><span class="b n">FY2026 · as of 2026-08-25</span><button class="btn sm q">Open cascade</button></div>
          </div>
          <div class="cbd flush">
            <table class="tbl">
              <thead><tr>
                <th>Portfolio · strategic intent</th><th class="num">Budget</th><th class="num">Committed</th>
                <th class="num">Actual</th><th style="width:150px">Spend</th><th class="num">Programs</th><th>Impact metric</th>
              </tr></thead>
              <tbody>
                <sc-for list="{{ports}}" as="p" hint-placeholder-count="5">
                  <tr class="hov">
                    <td>
                      <div style="font-weight:700">{{p.name}}</div>
                      <div style="color:#5A6E7A;font-size:11px;font-weight:600">{{p.intent}}</div>
                    </td>
                    <td class="num">{{p.budget}}</td>
                    <td class="num">{{p.comm}}</td>
                    <td class="num">{{p.actual}}</td>
                    <td><div class="bar"><i style="width:{{p.pct}}"></i></div></td>
                    <td class="num">{{p.progs}}</td>
                    <td><span class="b c">{{p.metric}}</span></td>
                  </tr>
                </sc-for>
              </tbody>
            </table>
          </div>
          <div class="prov">
            <span>Source</span><span class="mono">view:portfolio-rollup@v12</span><span>·</span>
            <span>credit basis <b>hard</b></span><span>·</span><span>as of 2026-08-25 08:02 UTC</span><span>·</span>
            <a>CSV</a><a>PDF</a>
          </div>
        </div>

        <div class="card" style="flex:1">
          <div class="chd"><h2>Activity</h2><div class="r"><span class="sub">humans and agents, one feed</span></div></div>
          <div class="cbd flush">
            <sc-for list="{{acts}}" as="a" hint-placeholder-count="6">
              <div style="display:flex;gap:9px;padding:9px 14px;border-bottom:1px solid #E7EEF2">
                <span class="b {{a.tone}}" style="height:17px">{{a.who}}</span>
                <div style="min-width:0">
                  <div style="font-weight:600">{{a.what}}</div>
                  <div style="color:#5A6E7A;font-size:11px;font-weight:600">{{a.when}} · {{a.where}}</div>
                </div>
              </div>
            </sc-for>
          </div>
        </div>
      </div>

      <div class="row" style="margin-top:14px">
        <div class="card" style="flex:1">
          <div class="chd">
            <h2>System health</h2>
            <div class="r"><span class="b g dot">19 of 21 modules green</span><button class="btn sm q">Open /health</button></div>
          </div>
          <div class="cbd" style="display:flex;gap:9px;flex-wrap:wrap">
            <sc-for list="{{health}}" as="h" hint-placeholder-count="8">
              <div style="display:flex;align-items:center;gap:7px;border:1px solid #E7EEF2;border-radius:20px;padding:4px 11px 4px 8px;background:#FCFDFE">
                <span style="width:7px;height:7px;border-radius:50%;background:{{h.color}}"></span>
                <span style="font-weight:700;font-size:11.5px">{{h.name}}</span>
                <span style="color:#5A6E7A;font-size:11px;font-weight:600">{{h.note}}</span>
              </div>
            </sc-for>
          </div>
        </div>
      </div>
    </div>
