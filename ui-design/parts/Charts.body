    <header class="top">
      <div class="crumb"><span class="jd">21.09</span><span>Budgets &amp; Financial Planning</span><span class="sep">/</span><b>Program financials</b></div>
      <div class="search"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><span>Search everything</span><span class="k">⌘K</span></div>
      <div class="tacts">
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M4 4v6h6M20 20v-6h-6"/><path d="M20 9A8 8 0 0 0 5.6 5.6M4 15a8 8 0 0 0 14.4 3.4"/></svg>Refresh</button>
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M6 9V3h12v6M6 18H4v-6h16v6h-2"/><path d="M8 14h8v7H8z"/></svg>Print</button>
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M9 13h7M9 17h4"/></svg>Export PDF</button>
      </div>
    </header>
    <div class="body">
      <div class="phead">
        <div>
          <p class="eyebrow">Program financials · FY2026 outlook</p>
          <h1>Budget, committed and actual</h1>
          <p class="lede">The Budget Report and Revenue Projection dashboards, re-hosted as platform views over live ledger data instead of a spreadsheet export. Same encodings, same rules: two lenses are never summed, and every chart ships the table behind it.</p>
        </div>
        <div class="sp"></div>
        <div style="text-align:right">
          <div style="font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:#5A6E7A">As of 2026-08-25</div>
          <div style="font-size:12px;color:#5A6E7A;margin-top:4px">
            <a>Rolling Budget</a> <span style="opacity:.5">|</span> <a>Gift pipeline</a> <span style="opacity:.5">|</span> <a>Program financials</a>
          </div>
        </div>
      </div>

      <div class="banner warn" style="margin-bottom:14px">
        <svg viewBox="0 0 24 24" style="width:15px;height:15px;stroke:currentColor;stroke-width:2;fill:none"><path d="M12 8v5M12 17h.01"/><circle cx="12" cy="12" r="9"/></svg>
        <span>Sage mirror is 26 hours behind. Actuals through 2026-08-24 are firm; anything after that is committed only.</span>
      </div>

      <div class="kpirow" style="margin-bottom:14px">
        <sc-for list="{{kpis}}" as="k" hint-placeholder-count="5">
          <div class="kpic" style="border-top-color:{{k.color}}">
            <div class="lbl">{{k.l}}</div>
            <div class="val {{k.tone}}">{{k.v}}</div>
            <div class="sub">{{k.d}}</div>
          </div>
        </sc-for>
      </div>

      <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:14px;align-items:center">
        <sc-for list="{{chips}}" as="c" hint-placeholder-count="5">
          <span class="schip {{c.cls}}">{{c.name}} · {{c.note}}</span>
        </sc-for>
        <div class="sp"></div>
        <label style="font-size:11.5px;font-weight:700;color:#5A6E7A;display:inline-flex;align-items:center;gap:6px;cursor:pointer" onClick="{{toggleInactive}}">
          <span class="{{inactiveBox}}" style="display:block;width:14px;height:14px;border-radius:3px;border:1.6px solid #C4D3DB"></span>
          Show inactive programs
        </label>
      </div>

      <div class="card" style="margin-bottom:14px">
        <div class="chd">
          <div>
            <h2>Program balance by month</h2>
            <div class="sub">Org-level running balance · solid = actuals, dashed = forecast, red line = zero</div>
          </div>
          <div class="r">
            <div class="legend">
              <sc-for list="{{legend1}}" as="l" hint-placeholder-count="3">
                <span class="{{l.cls}}" onClick="{{l.toggle}}"><span class="sw" style="background:{{l.swatch}}"></span>{{l.name}}</span>
              </sc-for>
            </div>
            <div class="seg">
              <button class="{{vChart}}" onClick="{{showChart}}">Chart</button>
              <button class="{{vTable}}" onClick="{{showTable}}">Table</button>
            </div>
          </div>
        </div>

        <sc-if value="{{isChart}}" hint-placeholder-val="{{ true }}">
          <div class="cbd">
            <svg viewBox="0 0 900 300" style="width:100%;height:auto">
              <line x1="58" y1="256" x2="884" y2="256" stroke="#C4D3DB" stroke-width="1.2"></line>
              <line x1="58" y1="16" x2="58" y2="256" stroke="#C4D3DB" stroke-width="1.2"></line>
              <line x1="58" y1="212" x2="884" y2="212" stroke="#D9534F" stroke-width="1.6" stroke-dasharray="6 4"></line>
              <text x="888" y="215" fill="#D9534F" font-size="9.5" font-weight="800">zero</text>
              <text x="50" y="216" text-anchor="end" fill="#5A6E7A" font-size="9.5" font-weight="700">$0</text>
              <text x="50" y="140" text-anchor="end" fill="#5A6E7A" font-size="9.5" font-weight="700">$1.5M</text>
              <text x="50" y="64" text-anchor="end" fill="#5A6E7A" font-size="9.5" font-weight="700">$3.0M</text>
              <sc-if value="{{showActual}}" hint-placeholder-val="{{ true }}">
                <polyline points="{{balActual}}" fill="none" stroke="#014263" stroke-width="2.6"></polyline>
              </sc-if>
              <sc-if value="{{showForecast}}" hint-placeholder-val="{{ true }}">
                <polyline points="{{balForecast}}" fill="none" stroke="#31ADE3" stroke-width="2.6" stroke-dasharray="7 4"></polyline>
              </sc-if>
              <sc-if value="{{showPrior}}" hint-placeholder-val="{{ true }}">
                <polyline points="{{balPrior}}" fill="none" stroke="#C4D3DB" stroke-width="2" stroke-dasharray="4 4"></polyline>
              </sc-if>
              <text x="72" y="278" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2025-10</text>
              <text x="222" y="278" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2025-12</text>
              <text x="372" y="278" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-02</text>
              <text x="522" y="278" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-04</text>
              <text x="672" y="278" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-06</text>
              <text x="822" y="278" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-08</text>
            </svg>
          </div>
        </sc-if>

        <sc-if value="{{isTable}}" hint-placeholder-val="{{ false }}">
          <div class="cbd flush">
            <table class="tbl">
              <thead><tr><th>Period</th><th class="num">Budget</th><th class="num">Committed</th><th class="num">Actual</th><th class="num">Balance</th><th class="num">Variance</th></tr></thead>
              <tbody>
                <sc-for list="{{rows}}" as="r" hint-placeholder-count="12">
                  <tr><td class="mono">{{r.period}}</td><td class="num">{{r.budget}}</td><td class="num">{{r.comm}}</td><td class="num">{{r.actual}}</td><td class="num">{{r.bal}}</td><td class="num" style="color:{{r.color}}">{{r.var}}</td></tr>
                </sc-for>
              </tbody>
            </table>
          </div>
        </sc-if>

        <div class="prov">
          <span>Query</span><span class="mono">chart:program-balance@v6 → query:gl-actuals-by-period@v11</span><span>·</span>
          <span>as of 2026-08-25 08:02 UTC</span><span>·</span><span>posted only</span><span>·</span>
          <a>CSV</a><a>PNG</a><a>SVG</a>
        </div>
      </div>

      <div class="row" style="align-items:flex-start">
        <div class="card" style="flex:1.35;min-width:0">
          <div class="chd">
            <div>
              <h2>Cumulative contributed revenue</h2>
              <div class="sub">Pipeline and trend are two lenses on the same money — never summed</div>
            </div>
            <div class="r">
              <div class="legend">
                <span class="item"><span class="sw" style="background:#014263"></span>Actual</span>
                <span class="item"><span class="sw" style="background:repeating-linear-gradient(90deg,#31ADE3 0 6px,transparent 6px 11px)"></span>Weighted projection</span>
                <span class="item"><span class="sw" style="background:#C4D3DB"></span>FY2025</span>
              </div>
            </div>
          </div>
          <div class="cbd">
            <svg viewBox="0 0 700 240" style="width:100%;height:auto">
              <line x1="46" y1="206" x2="686" y2="206" stroke="#C4D3DB" stroke-width="1.2"></line>
              <line x1="46" y1="16" x2="46" y2="206" stroke="#C4D3DB" stroke-width="1.2"></line>
              <polyline points="{{revPrior}}" fill="none" stroke="#C4D3DB" stroke-width="2" stroke-dasharray="4 4"></polyline>
              <polyline points="{{revActual}}" fill="none" stroke="#014263" stroke-width="2.6"></polyline>
              <polyline points="{{revProj}}" fill="none" stroke="#31ADE3" stroke-width="2.6" stroke-dasharray="7 4"></polyline>
              <circle cx="{{revSplitX}}" cy="{{revSplitY}}" r="3.6" fill="#014263"></circle>
              <text x="60" y="228" fill="#5A6E7A" font-size="9" font-weight="700">2025-10</text>
              <text x="360" y="228" text-anchor="middle" fill="#5A6E7A" font-size="9" font-weight="700">2026-03</text>
              <text x="672" y="228" text-anchor="end" fill="#5A6E7A" font-size="9" font-weight="700">2026-09</text>
            </svg>
            <div class="ctitle">Credit basis: <b>hard</b> — ties to contributed revenue in the ledger. Switch a donor view to soft_inclusive and the totals deliberately exceed it.</div>
          </div>
        </div>

        <div class="card" style="flex:1;min-width:0">
          <div class="chd"><h2>Standard chart library</h2><div class="r"><span class="sub">one definition each</span></div></div>
          <div class="cbd flush">
            <sc-for list="{{lib}}" as="l" hint-placeholder-count="9">
              <div class="{{l.cls}}" style="display:flex;align-items:center;gap:9px;padding:8px 14px;border-bottom:1px solid #E7EEF2;cursor:pointer" onClick="{{l.pick}}">
                <span class="b {{l.tone}}" style="width:76px;justify-content:center">{{l.kind}}</span>
                <div style="min-width:0">
                  <div style="font-weight:700;font-size:12.5px">{{l.name}}</div>
                  <div style="color:#5A6E7A;font-size:11px;font-weight:600">{{l.note}}</div>
                </div>
              </div>
            </sc-for>
          </div>
        </div>
      </div>

      <div class="card" style="margin-top:14px">
        <div class="cbd">
          <div class="gate">
            <svg viewBox="0 0 24 24"><path d="M12 9v5M12 17h.01"/><path d="M10.3 4.3 2.6 18a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0z"/></svg>
            <div><b>Data quality.</b> {{dq}}</div>
          </div>
        </div>
      </div>
    </div>
