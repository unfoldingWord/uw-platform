<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { decided: {} }; }
  renderVals() {
    const s = this.state;
    const raw = [
      { id: 'a1', title: 'Send the revised training calendar to the Chad partner', owner: 'Amara Doumbé', due: 'due 2026-08-28', anchor: 'transcript@v1 L142', quote: 'I will get the revised calendar over to them before the end of the week.' },
      { id: 'a2', title: 'Ask finance whether the 18% assessment applies to the match', owner: 'Jesse Griffin', due: 'no date stated', anchor: 'transcript@v1 L211', quote: 'Someone needs to check whether the assessment hits the matched portion.' },
      { id: 'a3', title: 'File the OBS completion numbers into the impact model', owner: 'Grace Mbeki', due: 'due 2026-08-29', anchor: 'transcript@v1 L268', quote: 'The completion count is five now, not four — that needs to be in the model.' },
      { id: 'a4', title: 'Book the November consultant checking week', owner: 'unassigned', due: 'no date stated', anchor: 'transcript@v1 L305', quote: 'We should get November on the calendar sooner rather than later.' },
    ];
    const actions = raw.map((a) => {
      const d = s.decided[a.id];
      return {
        ...a,
        open: !d, done: !!d,
        textCls: d === 'drop' ? 'done' : '',
        doneTone: d === 'confirm' ? 'g' : 'n',
        doneLabel: d === 'confirm' ? 'confirmed — now a task' : 'discarded',
        confirm: () => this.setState({ decided: { ...s.decided, [a.id]: 'confirm' } }),
        drop: () => this.setState({ decided: { ...s.decided, [a.id]: 'drop' } }),
      };
    });
    return {
      actions, nOpen: raw.filter((a) => !s.decided[a.id]).length,
      lines: [
        { t: '00:04:12', who: 'Amara Doumbé:', text: 'The eastern cluster access window closed again last week, so module four slips unless we run it remotely.' },
        { t: '00:05:40', who: 'Jesse Griffin:', text: 'The work order has a remote contingency costed in. Let us use it rather than renegotiate.' },
        { t: '00:07:02', who: 'Grace Mbeki:', text: 'The completion count is five now, not four — that needs to be in the model before the Q3 report.' },
        { t: '00:09:18', who: 'Amara Doumbé:', text: 'I will get the revised calendar over to them before the end of the week.' },
        { t: '00:14:55', who: 'Jesse Griffin:', text: 'Someone needs to check whether the assessment hits the matched portion. Flagging that as a decision for finance.' },
      ],
      corr: [
        { how: 'exact', tone: 'g', what: 'Zoom meeting UUID ↔ calendar event', why: 'the Zoom link was in the event body' },
        { how: 'exact', tone: 'g', what: 'Calendar event ↔ meeting page', why: 'the page stores the Google event id' },
        { how: 'exact', tone: 'g', what: 'Attendees ↔ people', why: '4 of 4 emails matched directory rows' },
        { how: 'inferred', tone: 'i', what: 'Meeting ↔ Chad Initiative', why: 'recurring series inherits its parent entity · confidence 0.94' },
        { how: 'inferred', tone: 'k', what: '4 action items extracted', why: 'suggested until the owner or organizer confirms' },
      ],
      meta: [
        { k: 'date', v: '2026-08-21 14:00 UTC' },
        { k: 'duration', v: '38 minutes' },
        { k: 'attendees', v: '4 · all matched' },
        { k: 'series', v: 'Field sync · fortnightly' },
        { k: 'entity', v: 'Chad Initiative' },
        { k: 'zulip topic', v: '#field-chad / cluster' },
      ],
    };
  }
}
</script>
