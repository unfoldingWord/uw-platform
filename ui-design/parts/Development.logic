<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { view: 'board', merged: false, product: 'all' }; }
  renderVals() {
    const s = this.state;
    const lanes = [
      { name: 'Backlog', tone: 'n', cards: [
        { ref: 'uw-app#511', title: 'Story bank consent expiry sweep', risk: 'low', riskTone: 'n', who: 'unassigned', product: 'Platform', prodTone: 'n' },
        { ref: 'uw-tc#901', title: 'Checking session export to FRED', risk: 'low', riskTone: 'n', who: 'unassigned', product: 'translationCore', prodTone: 'i' },
      ] },
      { name: 'In progress', tone: 'i', cards: [
        { ref: 'uw-app#498', title: 'Expense allocation from calendar joins', risk: 'medium', riskTone: 'k', who: 'agent lane 2', product: 'Platform', prodTone: 'n' },
        { ref: 'uw-tc#908', title: 'Alignment memory across books', risk: 'medium', riskTone: 'k', who: 'jesse', product: 'translationCore', prodTone: 'i' },
        { ref: 'uw-bts#233', title: 'Message queue retry on flaky networks', risk: 'medium', riskTone: 'k', who: 'agent lane 3', product: 'BT Servant', prodTone: 'c' },
      ] },
      { name: 'In review', tone: 'r', cards: [
        { ref: 'uw-app#482', title: 'Ledger posting validation', risk: 'ledger', riskTone: 'r', who: 'jesse + harness', product: 'Platform', prodTone: 'n' },
        { ref: 'uw-app#495', title: 'ACL scope filter on field data', risk: 'acl', riskTone: 'r', who: 'harness', product: 'Platform', prodTone: 'n' },
        { ref: 'uw-tc#912', title: 'Offline cache invalidation on reconnect', risk: 'low', riskTone: 'n', who: 'agent lane 1', product: 'translationCore', prodTone: 'i' },
      ] },
      { name: 'Done this sprint', tone: 'g', cards: [
        { ref: 'uw-app#476', title: 'Page version redline renderer', risk: 'low', riskTone: 'n', who: 'jesse', product: 'Platform', prodTone: 'n' },
        { ref: 'uw-bts#228', title: 'Phone-first checking flow', risk: 'high', riskTone: 'k', who: 'jesse', product: 'BT Servant', prodTone: 'c' },
      ] },
    ].map((l) => {
      const cards = l.cards.filter((c) => s.product === 'all' || c.product === s.product);
      return { ...l, cards, count: cards.length };
    });

    const rem = [120, 116, 108, 99, 96, 84, 71, 58, 51, 38, 26];
    const burn = rem.map((v, i) => Math.round(52 + i * (828 / 10)) + ',' + Math.round(220 - (v / 120) * 190)).join(' ');
    const days = rem.map((v, i) => ({ x: Math.round(52 + i * (828 / 10)), label: '08-' + (11 + i) }));

    const gates = [
      { name: 'Declares what it closes', req: 'PR body names the issue and the module it touches', result: 'pass', tone: 'g' },
      { name: 'Declares what it risks', req: 'risk tier stated; ledger tier takes the full harness plus a named human', result: 'pass', tone: 'g' },
      { name: 'Declares collateral touched', req: 'lists every other module read or written', result: 'pass', tone: 'g' },
      { name: 'Property tests', req: 'any generated posting balances or is rejected', result: '2,000 cases pass', tone: 'g' },
      { name: 'Independent reviewers', req: 'findings fixed or refuted with evidence', result: '1 open finding', tone: 'k' },
      { name: 'Human approval', req: 'a human merges — always', result: 'waiting on you', tone: 'k' },
    ];

    return {
      vBoard: s.view === 'board' ? 'on' : '', vFlow: s.view === 'flow' ? 'on' : '', vGate: s.view === 'gate' ? 'on' : '',
      goBoard: () => this.setState({ view: 'board' }), goFlow: () => this.setState({ view: 'flow' }), goGate: () => this.setState({ view: 'gate' }),
      isBoard: s.view === 'board', isFlow: s.view === 'flow', isGate: s.view === 'gate',
      lanes, burn, days, gates,
      prodFilters: ['all', 'Platform', 'translationCore', 'BT Servant', 'Open Bible Stories'].map((p) => ({
        label: p === 'all' ? 'All products' : p,
        cls: 'chip' + (s.product === p ? ' on' : ''),
        pick: () => this.setState({ product: p }),
      })),
      mergeCls: 'btn' + (s.merged ? ' off' : ' p'),
      mergeLabel: s.merged ? 'Merged by Jesse Griffin · 2026-08-25' : 'Merge (1 finding still open)',
      merge: () => this.setState({ merged: true }),
      mergeNote: s.merged
        ? 'Recorded with the reviewer transcript attached. The open finding was refuted with evidence, and that refutation is now a learning page.'
        : 'The button is available because a human is allowed to overrule the harness — but the override, and its reason, ride into the audit trail with the merge.',
      reviews: [
        { lens: 'correctness', tone: 'i', finding: 'Rounding on the assessment split can leave a one-cent residual', state: 'fixed in 3rd commit · property test added' },
        { lens: 'security', tone: 'i', finding: 'Posting path did not re-check the principal after the queue hop', state: 'fixed · regression test added' },
        { lens: 'correctness', tone: 'k', finding: 'Claims the period-close check is redundant here', state: 'open — refuted by the author, awaiting your call' },
        { lens: 'premise', tone: 'g', finding: 'Verified the issue premise against current code before building', state: 'confirmed · scope unchanged' },
      ],
    };
  }
}
</script>
