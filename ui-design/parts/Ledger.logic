<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { tab: 'journal', open: 'JE-2026-0812', posted: {}, filter: 'all', pIdx: 0 }; }
  renderVals() {
    const s = this.state;
    const periods = ['2026-08', '2026-07', '2026-06'];
    const period = periods[s.pIdx];

    const base = [
      { id: 'JE-2026-0812', desc: 'August operational assessment — 18% on semi-restricted funds', date: '2026-08-25', src: 'agent draft', srcTone: 'k', amt: '$47,180.00', draft: true },
      { id: 'JE-2026-0811', desc: 'Expense report — Chad training trip (4 items)', date: '2026-08-24', src: 'agent draft', srcTone: 'k', amt: '$3,412.60', draft: true },
      { id: 'JE-2026-0810', desc: 'Stripe payout 2026-08-22 — 41 gifts', date: '2026-08-23', src: 'stripe', srcTone: 'i', amt: '$28,940.00', draft: false },
      { id: 'JE-2026-0809', desc: 'Partner invoice PI-2026-118 — Chad facilitator cohort', date: '2026-08-22', src: 'human:jesse', srcTone: 'n', amt: '$62,000.00', draft: false },
      { id: 'JE-2026-0808', desc: 'Payroll allocation by area of responsibility', date: '2026-08-20', src: 'cron', srcTone: 'i', amt: '$118,204.00', draft: false },
      { id: 'JE-2026-0807', desc: 'Grant award recognition — Foundation 2025-3311 tranche 2', date: '2026-08-18', src: 'human:jesse', srcTone: 'n', amt: '$250,000.00', draft: false },
    ];
    const jes = base
      .filter((j) => s.filter === 'all' || (s.filter === 'drafts' ? (j.draft && !s.posted[j.id]) : s.filter === 'agent' ? j.srcTone === 'k' : !j.draft || s.posted[j.id]))
      .map((j) => {
        const isDraft = j.draft && !s.posted[j.id];
        return {
          ...j,
          status: isDraft ? 'draft' : 'posted',
          stTone: isDraft ? 'k' : 'g',
          postable: isDraft,
          caret: s.open === j.id ? '▾' : '▸',
          selCls: s.open === j.id ? 'sel' : '',
          toggle: () => this.setState({ open: s.open === j.id ? '' : j.id }),
          post: () => this.setState({ posted: { ...s.posted, [j.id]: true }, open: j.id }),
        };
      });

    const lineSets = {
      'JE-2026-0812': [
        { acct: '7900 Assessment expense', fund: 'GAU-CCBT Church-Centric', func: 'Program', prog: 'Chad Initiative', dr: '$21,384.00', cr: '' },
        { acct: '7900 Assessment expense', fund: 'GAU-CONTENT Content', func: 'Program', prog: 'Gateway Language Support', dr: '$14,206.00', cr: '' },
        { acct: '7900 Assessment expense', fund: 'GAU-TECH Tools', func: 'Program', prog: 'translationCore', dr: '$11,590.00', cr: '' },
        { acct: '4900 Assessment revenue', fund: 'Unrestricted', func: 'Management & general', prog: '—', dr: '', cr: '$47,180.00' },
      ],
      'JE-2026-0811': [
        { acct: '6210 Travel', fund: 'GAU-CCBT Church-Centric', func: 'Program', prog: 'Chad Initiative', dr: '$2,180.40', cr: '' },
        { acct: '6230 Lodging', fund: 'GAU-CCBT Church-Centric', func: 'Program', prog: 'Chad Initiative', dr: '$981.20', cr: '' },
        { acct: '6240 Meals', fund: 'GAU-CCBT Church-Centric', func: 'Program', prog: 'Chad Initiative', dr: '$251.00', cr: '' },
        { acct: '2110 Accrued reimbursements', fund: 'Unrestricted', func: 'Management & general', prog: '—', dr: '', cr: '$3,412.60' },
      ],
    };
    const lines = lineSets[s.open] || [
      { acct: '1010 Operating cash', fund: 'Unrestricted', func: 'Management & general', prog: '—', dr: '$28,940.00', cr: '' },
      { acct: '4010 Contributions', fund: 'GAU-CCBT Church-Centric', func: 'Program', prog: '—', dr: '', cr: '$22,140.00' },
      { acct: '4010 Contributions', fund: 'Unrestricted', func: 'Management & general', prog: '—', dr: '', cr: '$6,800.00' },
    ];

    const openJe = base.find((j) => j.id === s.open);
    const openIsDraft = openJe && openJe.draft && !s.posted[openJe.id];

    const funds = [
      { name: 'GAU-CCBT · Church-Centric BT', restr: 'semi-restricted', tone: 'i', open: '$412,900', recv: '$1,214,000', rel: '$1,188,400', asmt: '$213,912', bal: '$224,588' },
      { name: 'GAU-CONTENT · Content Development', restr: 'semi-restricted', tone: 'i', open: '$264,100', recv: '$702,000', rel: '$618,900', asmt: '$111,402', bal: '$235,798' },
      { name: 'GAU-TECH · Tools & Technology', restr: 'semi-restricted', tone: 'i', open: '$188,400', recv: '$651,000', rel: '$590,200', asmt: '$106,236', bal: '$142,964' },
      { name: 'GAU-TRAIN · Field Training', restr: 'semi-restricted', tone: 'i', open: '$96,200', recv: '$318,000', rel: '$274,500', asmt: '$49,410', bal: '$90,290' },
      { name: 'Catalyst Partners', restr: 'unrestricted', tone: 'c', open: '$204,800', recv: '$412,000', rel: '$96,300', asmt: '$0', bal: '$520,500' },
      { name: 'Board designated reserve', restr: 'board designated', tone: 'n', open: '$620,000', recv: '$0', rel: '$0', asmt: '$0', bal: '$620,000' },
    ];

    const bva = [
      { name: 'Church-Centric BT', budget: 1840000, comm: 1512000, actual: 1188400 },
      { name: 'Content Development', budget: 960000, comm: 742000, actual: 618900 },
      { name: 'Tools & Technology', budget: 720000, comm: 655000, actual: 590200 },
      { name: 'Field Training', budget: 480000, comm: 391000, actual: 274500 },
      { name: 'Catalyst Partners', budget: 300000, comm: 120000, actual: 96300 },
    ].map((b) => {
      const v = Math.round(((b.actual / b.budget) - 0.64) * 100);
      return {
        name: b.name,
        budget: '$' + b.budget.toLocaleString('en-US'),
        actual: '$' + b.actual.toLocaleString('en-US'),
        commPct: Math.round((b.comm / b.budget) * 100) + '%',
        actPct: Math.round((b.actual / b.budget) * 100) + '%',
        var: (v >= 0 ? '+' : '') + v + ' pts',
        tone: v > 8 ? 'r' : v < -8 ? 'k' : 'g',
      };
    });

    const fx = [
      { code: '6100', name: 'Salaries & benefits', prog: '$1,412,000', mg: '$318,000', fr: '$204,000', tot: '$1,934,000' },
      { code: '6210', name: 'Travel', prog: '$286,400', mg: '$21,000', fr: '$18,600', tot: '$326,000' },
      { code: '6300', name: 'Partner grants & subawards', prog: '$742,000', mg: '$0', fr: '$0', tot: '$742,000' },
      { code: '6400', name: 'Software & infrastructure', prog: '$41,200', mg: '$34,800', fr: '$6,100', tot: '$82,100' },
      { code: '6500', name: 'Professional fees', prog: '$18,000', mg: '$96,400', fr: '$12,000', tot: '$126,400' },
      { code: '6600', name: 'Events & training delivery', prog: '$198,300', mg: '$4,200', fr: '$9,800', tot: '$212,300' },
      { code: '7900', name: 'Operational assessment', prog: '$378,000', mg: '−$378,000', fr: '$0', tot: '$0' },
    ];

    const filters = [
      { key: 'all', label: 'All' }, { key: 'drafts', label: 'Drafts only' },
      { key: 'agent', label: 'Agent-drafted' }, { key: 'posted', label: 'Posted' },
    ].map((f) => ({ label: f.label, cls: 'chip' + (s.filter === f.key ? ' on' : ''), pick: () => this.setState({ filter: f.key }) }));

    const nDrafts = base.filter((j) => j.draft && !s.posted[j.id]).length;

    return {
      period, prevP: () => this.setState({ pIdx: Math.min(2, s.pIdx + 1) }), nextP: () => this.setState({ pIdx: Math.max(0, s.pIdx - 1) }),
      closeCls: 'btn' + (nDrafts ? ' off' : ' p'),
      closeLabel: nDrafts ? 'Close period — ' + nDrafts + ' drafts open' : 'Close period',
      closeP: () => {},
      ledgerNote: nDrafts
        ? 'Agents draft entries and finance posts them. ' + nDrafts + ' drafts are waiting; the period cannot close until every one is posted or rejected.'
        : 'Every draft is cleared. The period is ready to close, and the nightly tamper-evident export will seal it.',
      nDrafts,
      t1: 'tab' + (s.tab === 'journal' ? ' on' : ''), t2: 'tab' + (s.tab === 'funds' ? ' on' : ''),
      t3: 'tab' + (s.tab === 'budget' ? ' on' : ''), t4: 'tab' + (s.tab === 'func' ? ' on' : ''),
      go1: () => this.setState({ tab: 'journal' }), go2: () => this.setState({ tab: 'funds' }),
      go3: () => this.setState({ tab: 'budget' }), go4: () => this.setState({ tab: 'func' }),
      isJournal: s.tab === 'journal', isFunds: s.tab === 'funds', isBudget: s.tab === 'budget', isFunc: s.tab === 'func',
      filters, jes, lines,
      hasOpen: !!s.open, openId: s.open,
      openDims: openIsDraft ? 'draft · not yet in any total' : 'posted · immutable',
      gateText: openIsDraft
        ? 'JE-' + s.open.slice(3) + ' was drafted by an agent. Posting is a human verb — it does not exist in any agent toolset, so no prompt can produce it.'
        : 'Nothing selected is awaiting a post. Posted entries are immutable; a correction is a reversing entry with its own audit trail.',
      checks: [
        { mark: 'ok', tone: 'g', text: 'Debits equal credits' },
        { mark: 'ok', tone: 'g', text: 'Every line has account × fund × function' },
        { mark: 'ok', tone: 'g', text: 'Period 2026-08 is open' },
        { mark: 'ok', tone: 'g', text: 'Donor restriction respected on every fund' },
        { mark: 'ok', tone: 'g', text: 'Actor holds admin(20–29)' },
      ],
      funds, bva, fx,
    };
  }
}
</script>
