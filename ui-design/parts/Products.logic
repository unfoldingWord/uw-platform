<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { sel: 'tc', tab: 'hyp' }; }
  renderVals() {
    const s = this.state;
    const defs = [
      { k: 'tc', jd: '82', name: 'translationCore', owner: 'Tools & Technology', stage: 'sustaining', tone: 'g' },
      { k: 'bts', jd: '84', name: 'BT Servant', owner: 'Tools & Technology', stage: 'building', tone: 'i' },
      { k: 'obs', jd: '87', name: 'Open Bible Stories', owner: 'Content Development', stage: 'sustaining', tone: 'g' },
      { k: 'fbt', jd: '83', name: 'Foundations BT', owner: 'Content Development', stage: 'sustaining', tone: 'g' },
      { k: 'ebp', jd: '81', name: 'English Book Packages', owner: 'Content Development', stage: 'sustaining', tone: 'g' },
      { k: 'slr', jd: '86', name: 'Strategic Language Resources', owner: 'Content Development', stage: 'building', tone: 'i' },
      { k: 'obtc', jd: '85', name: 'Open Bible Technology Community', owner: 'Tools & Technology', stage: 'exploring', tone: 'k' },
    ];
    const catalog = defs.map((d) => ({ ...d, cls: d.k === s.sel ? 'sel-row' : '', pick: () => this.setState({ sel: d.k }) }));
    const cur = defs.find((d) => d.k === s.sel) || defs[0];

    const detail = {
      tc: {
        summary: 'The desktop and web toolset translators use to draft, align and check. Its adoption is what makes checking possible without an outside consultant in the room, so its roadmap is driven by what field cohorts get stuck on rather than by feature requests.',
        kpis: [ { l: 'Active installs', v: '4,180', d: '+12% this quarter' }, { l: 'Languages served', v: '212', d: 'across 31 partners' }, { l: 'Open issues', v: '46', d: '9 in this sprint' }, { l: 'Spend FY26', v: '$364K', d: '51% of budget' } ],
        serves: [ { rel: 'owned by', tone: 'i', name: 'Tools & Technology portfolio' }, { rel: 'also serves', tone: 'c', name: 'Chad Initiative' }, { rel: 'also serves', tone: 'c', name: 'Gateway Language Support' }, { rel: 'delivered by', tone: 'n', name: '4 projects · 2 active' } ],
      },
      bts: {
        summary: 'A messaging-first assistant for translators working from a phone, in places where a laptop and a stable connection are not a given. Still proving its core premise before it earns a wider rollout.',
        kpis: [ { l: 'Pilot users', v: '86', d: '3 countries' }, { l: 'Sessions / week', v: '412', d: '+38% this month' }, { l: 'Open issues', v: '61', d: '14 in this sprint' }, { l: 'Spend FY26', v: '$186K', d: '62% of budget' } ],
        serves: [ { rel: 'owned by', tone: 'i', name: 'Tools & Technology portfolio' }, { rel: 'also serves', tone: 'c', name: 'Chad Initiative' }, { rel: 'grant', tone: 'c', name: 'Foundation award 2025-3311' }, { rel: 'delivered by', tone: 'n', name: '3 projects · 3 active' } ],
      },
    };
    const d = detail[s.sel] || {
      summary: 'Every product carries the same shape: a charter, hypotheses with expected evidence, a roadmap, the work in flight, and the programs it serves. That shape is what makes twenty-odd products comparable.',
      kpis: [ { l: 'Open issues', v: '—', d: 'no repository linked yet' }, { l: 'Spend FY26', v: '—', d: 'no budget line yet' } ],
      serves: [ { rel: 'owned by', tone: 'i', name: cur.owner } ],
    };

    const setT = (k) => () => this.setState({ tab: k });
    return {
      catalog,
      name: cur.name, jd: cur.jd, stage: cur.stage, tone: cur.tone, owner: cur.owner,
      summary: d.summary, kpis: d.kpis, serves: d.serves,
      tHyp: 'tab' + (s.tab === 'hyp' ? ' on' : ''), tRoad: 'tab' + (s.tab === 'road' ? ' on' : ''), tWork: 'tab' + (s.tab === 'work' ? ' on' : ''),
      goHyp: setT('hyp'), goRoad: setT('road'), goWork: setT('work'),
      isHyp: s.tab === 'hyp', isRoad: s.tab === 'road', isWork: s.tab === 'work',
      tabTitle: { hyp: 'Hypotheses and what would prove them', road: 'Roadmap', work: 'Work in flight' }[s.tab],
      hyps: [
        { text: 'Cohorts that use alignment early finish checking faster', exp: 'Two cohorts, one trained on alignment in module 2 instead of module 4', ev: 'Median days from draft to community check drops by a third', result: 'supported', tone: 'g' },
        { text: 'Offline mode is what blocks adoption in the eastern cluster', exp: 'Ship the offline build to 12 facilitators and watch session counts', ev: 'Weekly sessions rise in low-connectivity districts', result: 'running', tone: 'i' },
        { text: 'Partners will self-report results if the form is inside the tool', exp: 'Embed the reporting step at the end of a checking session', ev: 'Half of partner orgs file without a staff reminder', result: 'not started', tone: 'n' },
        { text: 'A consultant queue inside the product reduces waiting', exp: 'Route check requests through the platform work queue', ev: 'Median wait for a consultant answer falls below 5 days', result: 'refuted', tone: 'r' },
      ],
      road: [
        { when: 'shipped', tone: 'g', name: 'Alignment rewrite', note: 'released 4.1 · closed 22 issues', pct: '100%' },
        { when: 'this quarter', tone: 'i', name: 'Offline build for field cohorts', note: '2 projects · blocked on sync review', pct: '64%' },
        { when: 'next', tone: 'n', name: 'Partner self-reporting step', note: 'depends on the field module', pct: '12%' },
        { when: 'later', tone: 'n', name: 'Consultant queue integration', note: 'parked after the refuted hypothesis', pct: '0%' },
      ],
      work: [
        { ref: 'uw-tc#912', title: 'Offline cache invalidation on reconnect', project: 'Offline build', sprint: '2026-34', who: 'agent lane 1', status: 'in review', tone: 'i' },
        { ref: 'uw-tc#908', title: 'Alignment memory across books', project: 'Alignment rewrite', sprint: '2026-34', who: 'jesse', status: 'in progress', tone: 'i' },
        { ref: 'uw-tc#901', title: 'Checking session export to FRED', project: 'Partner reporting', sprint: '2026-35', who: 'unassigned', status: 'backlog', tone: 'n' },
        { ref: 'uw-tc#894', title: 'Crash on very large alignment files', project: 'Offline build', sprint: '2026-33', who: 'jesse', status: 'done', tone: 'g' },
        { ref: 'uw-tc#889', title: 'Arabic script rendering in the checker', project: 'Alignment rewrite', sprint: '2026-33', who: 'agent lane 2', status: 'done', tone: 'g' },
      ],
      props: [
        { k: 'type', v: 'product' }, { k: 'jd category', v: cur.jd + ' · ' + cur.name },
        { k: 'owning portfolio', v: cur.owner }, { k: 'stage', v: cur.stage },
        { k: 'licence', v: 'CC BY-SA 4.0' }, { k: 'repository', v: 'unfoldingWord/' + cur.k },
        { k: 'support level', v: 'field-critical' }, { k: 'offline_eligible', v: 'pages sync' },
      ],
      releases: [
        { date: '2026-07-30', ver: '4.2', note: 'checking speed, 31 fixes' },
        { date: '2026-04-18', ver: '4.1', note: 'alignment rewrite' },
        { date: '2026-01-22', ver: '4.0', note: 'new project format' },
        { date: '2025-10-04', ver: '3.9', note: 'final 3.x maintenance' },
      ],
      policies: [
        { kind: 'required', tone: 'r', name: 'Open licence policy' },
        { kind: 'required', tone: 'r', name: 'Field data sensitivity policy' },
        { kind: 'template', tone: 'n', name: 'Product charter (NISO) v4' },
      ],
    };
  }
}
</script>
