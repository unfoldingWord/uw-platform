<script data-dc-script data-props='{"$preview":{"width":1440,"height":1000}}'>
class Component extends DCLogic {
  constructor(p) { super(p); this.state = { sel: 'st1', level: 'private_circulation', filter: 'all', refusal: '', published: {} }; }
  renderVals() {
    const s = this.state;
    const rank = { internal: 0, private_circulation: 1, newsletter: 2, public: 3 };
    const toneOf = { internal: 'n', private_circulation: 'c', newsletter: 'i', public: 'g' };

    const stories = [
      { id: 'st1', title: 'A church in Chad reads Ruth in its own language', where: 'Chad · protected · Chad Initiative', date: '2026-08-12', level: s.level },
      { id: 'st2', title: 'The facilitator who trained the next four', where: 'Chad · Field Training', date: '2026-06-30', level: 'newsletter' },
      { id: 'st3', title: 'What the access restriction cost the cohort', where: 'Chad · internal review', date: '2026-08-19', level: 'internal' },
      { id: 'st4', title: 'Why we train trainers instead of translators', where: 'method · no named subjects', date: '2026-04-02', level: 'public' },
      { id: 'st5', title: 'A partner organization files its own report', where: 'Nigeria · Field Programs', date: '2026-07-11', level: 'private_circulation' },
    ];
    const filters = [
      { k: 'all', l: 'All' }, { k: 'internal', l: 'internal' }, { k: 'private_circulation', l: 'private' },
      { k: 'newsletter', l: 'newsletter' }, { k: 'public', l: 'public' },
    ].map((f) => ({ label: f.l, cls: 'chip' + (s.filter === f.k ? ' on' : ''), pick: () => this.setState({ filter: f.k }) }));

    const list = stories.filter((st) => s.filter === 'all' || st.level === s.filter).map((st) => ({
      ...st, tone: toneOf[st.level], cls: st.id === s.sel ? 'sel-row' : '', pick: () => this.setState({ sel: st.id, refusal: '' }),
    }));

    const cur = rank[s.level];
    const channels = [
      { key: 'internal', name: 'staff views', desc: 'Inside the platform only', note: 'Never leaves. Always available.' },
      { key: 'private_circulation', name: 'private', desc: 'Named partners, board packets, one-to-one funder communication', note: 'Behind access or a signed link.' },
      { key: 'newsletter', name: 'newsletter', desc: 'Supporter mailings, printed reports, closed-list publications', note: 'Published, but not indexable.' },
      { key: 'public', name: 'public web', desc: 'Open internet, indexed, quotable by press', note: 'Irreversible in practice — assume it is archived.' },
    ].map((c) => {
      const allowed = rank[c.key] <= cur;
      const done = s.published[c.key];
      return {
        ...c, tone: toneOf[c.key],
        cls: 'btn sm' + (allowed ? (done ? '' : ' p') : ' off'),
        cta: allowed ? (done ? 'rendered · usage logged' : 'Render here') : 'above this story’s level',
        act: () => {
          if (allowed) this.setState({ published: { ...s.published, [c.key]: true }, refusal: '' });
          else this.setState({ refusal: 'This story is set to ' + s.level + '. The publish pipeline, the newsletter generator and the grant-report assembler all read that level and will not render it into ' + c.name + '. Raise the level deliberately — after checking consent — or pick a story that already carries it.' });
        },
      };
    });

    const ladder = [
      { k: 'internal', name: 'internal', desc: 'staff views inside the platform only', color: '#5A6E7A' },
      { k: 'private_circulation', name: 'private_circulation', desc: 'named partners, board packets, funder letters', color: '#4FA9AC' },
      { k: 'newsletter', name: 'newsletter', desc: 'supporter mailings and printed reports', color: '#31ADE3' },
      { k: 'public', name: 'public', desc: 'open internet, indexed, quotable', color: '#2E9E5B' },
    ].map((l) => ({
      ...l,
      cls: l.k === s.level ? 'kc sel-row' : 'kc',
      pick: () => this.setState({ level: l.k, refusal: '', published: {} }),
    }));

    return {
      filters, list,
      title: 'A church in Chad reads Ruth in its own language',
      level: s.level, tone: toneOf[s.level],
      collected: '2026-08-12', collector: 'Amara Doumbé',
      body1: 'The cluster cohort finished checking Ruth in early August. On the following Sunday a congregation of about sixty heard the book read aloud in the language they speak at home, rather than in the language of the nearest city.',
      body2: 'The facilitator who led the checking had been trained in the first cohort eighteen months earlier and now runs sessions without an outside trainer present — which is the outcome this program exists to produce.',
      tags: [
        { k: 'filed at', v: '44.13 · also 63.96', tone: 'n' }, { k: 'country', v: 'TD', tone: 'n' }, { k: 'language', v: 'ISO tag withheld', tone: 'n' },
        { k: 'program', v: 'Chad Initiative', tone: 'i' }, { k: 'portfolio', v: 'Church-Centric BT', tone: 'i' },
        { k: 'grant', v: 'Foundation 2025-3311', tone: 'c' }, { k: 'training event', v: '2026-08-08 checking session', tone: 'c' },
      ],
      channels, ladder,
      refused: !!s.refusal, refusedText: s.refusal,
      usages: [
        { ch: 'board_packet', tone: 'c', artifact: '2026-08-06 board packet, p. 11', date: '2026-08-06', aud: '9 board members' },
        { ch: 'grant_report', tone: 'i', artifact: 'Foundation 2025-3311 Q2 report', date: '2026-07-15', aud: 'one funder' },
        { ch: 'newsletter', tone: 'n', artifact: '—', date: '—', aud: 'not used at this level' },
      ],
      consentTone: 'g', consentState: 'on file',
      consent: [
        { k: 'consent_ref', v: 'signed release · R2 2026-08-10' },
        { k: 'consent_expires', v: '2028-08-10' },
        { k: 'subject_anonymized', v: 'true' },
        { k: 'name_use', v: 'none' },
        { k: 'location_precision', v: 'country' },
        { k: 'photo_release', v: 'not granted — text only' },
        { k: 'review_by', v: '2027-02-01' },
      ],
    };
  }
}
</script>
