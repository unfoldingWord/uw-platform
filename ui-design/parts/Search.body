    <header class="top">
      <div class="crumb"><b>Today</b><span class="sep">·</span><span>2026-08-25</span></div>
      <div class="search" style="border-color:#31ADE3;background:#fff"><svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg><span style="color:#231F20;font-weight:700">chad</span><span class="k">esc</span></div>
      <div class="tacts">
        <button class="btn"><svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>New</button>
      </div>
    </header>
    <div class="body" style="position:relative">
      <div style="opacity:.22;pointer-events:none">
        <div class="phead"><div><p class="eyebrow">Tuesday · 2026-08-25</p><h1>Good morning, Jesse</h1></div></div>
        <div class="row">
          <div class="card" style="flex:1.15"><div class="chd"><h2>Waiting on me</h2></div><div class="cbd" style="height:180px"></div></div>
          <div class="card" style="flex:1"><div class="chd"><h2>My tasks</h2></div><div class="cbd" style="height:180px"></div></div>
        </div>
        <div class="row" style="margin-top:14px">
          <div class="card" style="flex:1"><div class="chd"><h2>Portfolios</h2></div><div class="cbd" style="height:220px"></div></div>
        </div>
      </div>

      <div style="position:absolute;left:50%;top:8px;transform:translateX(-50%);width:760px;background:#fff;border:1px solid var(--line);border-radius:12px;box-shadow:0 18px 48px rgba(1,66,99,.22);overflow:hidden">
        <div style="display:flex;align-items:center;gap:11px;padding:14px 16px;border-bottom:1px solid var(--line)">
          <svg viewBox="0 0 24 24" style="width:18px;height:18px;stroke:#5A6E7A;stroke-width:1.8;fill:none"><circle cx="11" cy="11" r="7"/><path d="m16.5 16.5 4 4"/></svg>
          <span style="font-size:16px;font-weight:700">chad</span>
          <span style="width:1.5px;height:19px;background:#31ADE3"></span>
          <div class="sp"></div>
          <span class="b n">{{count}} results · scoped to your grants</span>
        </div>
        <div style="padding:9px 14px;border-bottom:1px solid #E7EEF2">
          <div class="chips">
            <sc-for list="{{filters}}" as="f" hint-placeholder-count="5">
              <button class="{{f.cls}}" onClick="{{f.pick}}">{{f.label}}</button>
            </sc-for>
          </div>
        </div>
        <div style="max-height:520px;overflow:auto">
          <sc-for list="{{groups}}" as="g" hint-placeholder-count="4">
            <div>
              <div style="padding:8px 16px 4px;font-size:9.5px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#5A6E7A;background:#FAFCFD">{{g.name}}</div>
              <sc-for list="{{g.items}}" as="i" hint-placeholder-count="4">
                <div class="{{i.cls}}" style="display:flex;align-items:center;gap:11px;padding:9px 16px;cursor:pointer" onClick="{{i.pick}}">
                  <span class="b {{i.tone}}" style="width:96px;justify-content:center">{{i.type}}</span>
                  <div style="min-width:0;flex:1">
                    <div style="font-weight:700;font-size:13px">{{i.title}}</div>
                    <div style="color:#5A6E7A;font-size:11px;font-weight:600">{{i.sub}}</div>
                  </div>
                  <span class="jd">{{i.jd}}</span>
                  <span class="mono" style="color:#5A6E7A;font-size:10.5px;width:96px;text-align:right">{{i.cascade}}</span>
                </div>
              </sc-for>
            </div>
          </sc-for>
        </div>
        <div style="display:flex;align-items:center;gap:12px;padding:9px 16px;border-top:1px solid var(--line);background:#FAFCFD;color:#5A6E7A;font-size:11px;font-weight:700">
          <span>↑↓ move</span><span>↵ open</span><span>⌘↵ open in new pane</span>
          <div class="sp"></div>
          <span>{{hiddenNote}}</span>
        </div>
      </div>
    </div>
